logger = get_logger(__name__)
_cleanup_done = False


def cleanup():
    global _cleanup_done
    if _cleanup_done:
        return
    _cleanup_done = True
    logger.info("应用关闭")


atexit.register(cleanup)


@asynccontextmanager
async def lifespan(app: FastAPI):
    logger.opt(raw=True).info("=" * 80 + "\n")

    try:
        path_manager.init_user_data_dirs()
    except Exception as e:
        logger.warning(f"初始化用户数据目录失败: {e}")

    try:
        copied = path_manager.init_user_configs()
        if copied:
            logger.info(f"已初始化用户配置文件: {copied}")
    except Exception as e:
        logger.warning(f"初始化用户配置文件失败: {e}")

    try:
        copied = path_manager.init_user_scripts()
        if copied:
            logger.info(f"已初始化用户脚本: {copied}")
    except Exception as e:
        logger.warning(f"初始化用户脚本失败: {e}")
[% if enable_update %]
    try:
        synced = path_manager.sync_declared_overwrites()
        if synced:
            logger.info(f"已按新版本对齐配置文件: {synced}")
    except Exception as e:
        logger.warning(f"对齐配置文件失败: {e}")
[% endif %]
    # 兜底：secrets.yaml 万一还有明文敏感键，启动时自动混淆（obf1: 前缀，防围观）。
    # 读取侧 get_config_value 对混淆值透明解密，业务代码无感知。
    try:
        from managers.secret_obfuscator import obfuscate_file_plain_secrets

        obfuscate_file_plain_secrets(path_manager.get_config_path("secrets.yaml"))
    except Exception as e:
        logger.warning(f"敏感配置混淆失败: {e}")
    logger.info("应用启动完成")

    yield

    cleanup()
    logger.opt(raw=True).info("=" * 80 + "\n")


app = FastAPI(title=[[ display_name | tojson ]], lifespan=lifespan)

[% if enable_feishu_auth %]
@app.middleware("http")
async def auth_required_middleware(request, call_next):
    """全员强制登录（auth.required=true 时）：/api/* 除 /api/auth/* 外一律要会话 cookie。

    豁免：CORS 预检 OPTIONS、/api/auth/*（登录流程自身）、非 /api 路径（SPA/静态资源）。
    未登录返回 401，前端据此弹登录墙。
    """
    path = request.url.path
    if not path.startswith("/api/") or path.startswith("/api/auth/") or request.method == "OPTIONS":
        return await call_next(request)
    from services.auth import feishu_auth, COOKIE_NAME
    if not feishu_auth.required:
        return await call_next(request)
    from fastapi.responses import JSONResponse
    user = feishu_auth.get_user(request.cookies.get(COOKIE_NAME, ""))
    if not user:
        return JSONResponse({"detail": "未登录或登录已过期"}, status_code=401)
    return await call_next(request)


[% endif %]
app.add_middleware(
    CORSMiddleware,
    allow_origins=get_local_origins(),
    allow_methods=["*"],
    allow_headers=["*"],
)

if path_manager.is_packaged:
    frontend_path = str(path_manager.get_frontend_path())
    assets_path = os.path.join(frontend_path, "assets")

    class ImmutableStaticFiles(StaticFiles):
        """assets 文件名带内容 hash，可放心长缓存（immutable）。"""

        def file_response(self, *args, **kwargs):
            response = super().file_response(*args, **kwargs)
            response.headers["Cache-Control"] = "public, max-age=31536000, immutable"
            return response

    app.mount("/assets", ImmutableStaticFiles(directory=assets_path), name="assets")


