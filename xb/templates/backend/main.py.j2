import atexit
import os
from fastapi import FastAPI
from fastapi.staticfiles import StaticFiles
from fastapi.responses import FileResponse
import uvicorn
from fastapi.middleware.cors import CORSMiddleware
from contextlib import asynccontextmanager
from managers import get_logger, path_manager
from api.config import router as config_router
from api.ports import router as ports_router
[% if enable_terminal %]
from api.terminal import router as terminal_router
[% endif %]
[% if enable_update %]
from api.update import router as update_router
[% endif %]
[% if enable_logs %]
from api.logs import attach_log_sink, router as logs_router
[% endif %]
[% if enable_csv_test %]
from api.factory_test import router as factory_test_router
[% endif %]
from api.settings import router as settings_router

logger = get_logger(__name__)
_cleanup_done = False


def cleanup():
    global _cleanup_done
    if _cleanup_done:
        return
    _cleanup_done = True
    logger.info("应用关闭")


atexit.register(cleanup)


@asynccontextmanager
async def lifespan(app: FastAPI):
    logger.opt(raw=True).info("=" * 80 + "\n")

    try:
        path_manager.init_user_data_dirs()
    except Exception as e:
        logger.warning(f"初始化用户数据目录失败: {e}")

    try:
        copied = path_manager.init_user_configs()
        if copied:
            logger.info(f"已初始化用户配置文件: {copied}")
    except Exception as e:
        logger.warning(f"初始化用户配置文件失败: {e}")

    try:
        copied = path_manager.init_user_scripts()
        if copied:
            logger.info(f"已初始化用户脚本: {copied}")
    except Exception as e:
        logger.warning(f"初始化用户脚本失败: {e}")
[% if enable_update %]
    try:
        synced = path_manager.sync_declared_overwrites()
        if synced:
            logger.info(f"已按新版本对齐配置文件: {synced}")
    except Exception as e:
        logger.warning(f"对齐配置文件失败: {e}")

    # 兜底（仅打包态）：用户 secrets.yaml 万一还有明文敏感键，自动混淆。
    # 开发态不混淆——发版者本地填的明文保持原样。
    if path_manager.is_packaged:
        try:
            from managers.secret_obfuscator import obfuscate_file_plain_secrets

            obfuscate_file_plain_secrets(path_manager.get_config_path("secrets.yaml"))
        except Exception as e:
            logger.warning(f"敏感配置混淆失败: {e}")
[% endif %]
    logger.info("应用启动完成")

    yield

    cleanup()
    logger.opt(raw=True).info("=" * 80 + "\n")


app = FastAPI(title=[[ display_name | tojson ]], lifespan=lifespan)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

if path_manager.is_packaged:
    frontend_path = str(path_manager.get_frontend_path())
    assets_path = os.path.join(frontend_path, "assets")

    class ImmutableStaticFiles(StaticFiles):
        """assets 文件名带内容 hash，可放心长缓存（immutable）。"""

        def file_response(self, *args, **kwargs):
            response = super().file_response(*args, **kwargs)
            response.headers["Cache-Control"] = "public, max-age=31536000, immutable"
            return response

    app.mount("/assets", ImmutableStaticFiles(directory=assets_path), name="assets")


app.include_router(config_router, prefix="/api")
app.include_router(ports_router, prefix="/api")
[% if enable_csv_test %]
app.include_router(factory_test_router, prefix="/api/factory-test")
[% endif %]
[% if enable_terminal %]
app.include_router(terminal_router, prefix="/api")
[% endif %]
[% if enable_update %]
app.include_router(update_router, prefix="/api")
[% endif %]
[% if enable_logs %]
app.include_router(logs_router, prefix="/api")
attach_log_sink()
[% endif %]
app.include_router(settings_router, prefix="/api")


@app.get("/api")
async def root():
    return {"message": "Hello from " + [[ display_name | tojson ]] + " Backend"}


@app.get("/api/health")
async def health():
    return {"status": "healthy"}


@app.get("/{full_path:path}")
async def serve_frontend(full_path: str):
    if not path_manager.is_packaged:
        frontend_port = path_manager.get_config_value("ports.frontend", default=5173)
        return {
            "error": "开发模式下前端通过 Vite 服务器访问",
            "frontend_url": f"http://localhost:{frontend_port}",
        }

    frontend_path = str(path_manager.get_frontend_path())

    # full_path 来自通配路由，可能带 ../；必须限制在 frontend 目录内，
    # 否则打包态会把本接口变成任意文件读取。
    root = os.path.abspath(frontend_path)
    file_path = os.path.abspath(os.path.join(root, full_path))
    try:
        if os.path.commonpath((root, file_path)) != root:
            return {"error": "File not found"}
    except ValueError:
        return {"error": "File not found"}
    if os.path.exists(file_path) and os.path.isfile(file_path):
        return FileResponse(file_path, headers={"Cache-Control": "no-cache"})

    index_path = os.path.join(frontend_path, "index.html")
    if os.path.exists(index_path):
        # 必须 no-cache：否则应用内更新后 Chromium 仍可能渲染缓存的旧页面
        return FileResponse(index_path, headers={"Cache-Control": "no-cache"})

    return {"error": "File not found"}


if __name__ == "__main__":
    backend_port = path_manager.get_config_value("ports.backend", default=8000)
    uvicorn.run(app, host="0.0.0.0", port=int(backend_port), log_config=None)
