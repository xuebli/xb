import pathlib
[% if enable_sudo %]
import re
[% endif %]
import shutil
import yaml
from fastapi import APIRouter, HTTPException
from pydantic import BaseModel, Field
from managers import path_manager, get_logger
[% if enable_sudo %]
from managers import sudoers_manager
[% endif %]


router = APIRouter()
logger = get_logger(__name__)


[% if enable_sudo %]
class ConfigRequest(BaseModel):
    sudo_password: str


[% endif %]
class PortSettings(BaseModel):
    backend: int = Field(ge=1, le=65535)
    frontend: int = Field(ge=1, le=65535)


class AppSettingsRequest(BaseModel):
[% if enable_sudo %]
    sudo_password: str | None = None
[% endif %]
    ports: PortSettings


class FileContentRequest(BaseModel):
    filename: str
    content: str




def _ensure_global_config_file():
    config_file = path_manager.get_config_path("global_config.yaml")
    if config_file.exists():
        return config_file

    config_file.parent.mkdir(parents=True, exist_ok=True)
    with open(config_file, "w", encoding="utf-8") as f:
        yaml.safe_dump({"ports": {"backend": 8000, "frontend": 5173}}, f, allow_unicode=True, sort_keys=False)
    return config_file


def _load_global_config_for_write() -> tuple[object, pathlib.Path]:
    config_file = _ensure_global_config_file()
    try:
        with open(config_file, "r", encoding="utf-8") as f:
            config = yaml.safe_load(f) or {}
    except yaml.YAMLError as e:
        raise HTTPException(status_code=400, detail=f"global_config.yaml 格式错误: {e}")

    if not isinstance(config, dict):
        raise HTTPException(status_code=400, detail="global_config.yaml 顶层必须是 YAML 对象")
    return config, config_file


def _write_global_config(config: dict, config_file: pathlib.Path) -> None:
    backup_path = config_file.with_suffix(".yaml.bak")
    if config_file.exists():
        shutil.copy2(config_file, backup_path)
        logger.info(f"已备份配置文件: {backup_path}")

    with open(config_file, "w", encoding="utf-8") as f:
        yaml.safe_dump(config, f, allow_unicode=True, sort_keys=False)

    path_manager.reload_config("global_config.yaml")


def _save_secret(key: str, value: str) -> None:
    """将敏感字段写入 secrets.yaml。"""
    secrets_file = path_manager.get_config_path("secrets.yaml")
    secrets_file.parent.mkdir(parents=True, exist_ok=True)

    secrets = {}
    if secrets_file.exists():
        with open(secrets_file, "r", encoding="utf-8") as f:
            secrets = yaml.safe_load(f) or {}

    backup_path = secrets_file.with_suffix(".yaml.bak")
    if secrets_file.exists():
        shutil.copy2(secrets_file, backup_path)

    secrets[key] = value
    with open(secrets_file, "w", encoding="utf-8") as f:
        yaml.safe_dump(secrets, f, allow_unicode=True, sort_keys=False)

    path_manager.reload_config("secrets.yaml")


@router.get("/settings")
async def get_settings():
    """读取可通过 UI 配置的应用设置。"""
    try:
        config_file = path_manager.get_config_path("global_config.yaml")
        config = path_manager.load_config("global_config.yaml")
        ports = config.get("ports") if isinstance(config, dict) else {}
        if not isinstance(ports, dict):
            ports = {}

        return {
            "config_path": str(config_file),
            "is_packaged": path_manager.is_packaged,
[% if enable_sudo %]
            "sudo_password_configured": bool(path_manager.get_config_value("sudo_password", config_file="secrets.yaml")),
[% endif %]
            "ports": {
                "backend": int(ports.get("backend") or 8000),
                "frontend": int(ports.get("frontend") or 5173),
            },
            "restart_required_keys": ["ports.backend", "ports.frontend"],
        }
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"读取应用设置失败: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail=f"读取应用设置失败: {str(e)}")


@router.post("/settings")
async def save_settings(req: AppSettingsRequest):
    """保存 UI 配置项；可热重载的配置保存后立即 reload。"""
    try:
        config, config_file = _load_global_config_for_write()

        config["ports"] = {
            "backend": req.ports.backend,
            "frontend": req.ports.frontend,
        }
[% if enable_sudo %]
        password = (req.sudo_password or "").strip()
        if password:
            _save_secret("sudo_password", password)
[% endif %]

        _write_global_config(config, config_file)

[% if enable_sudo %]
        sudo_updated = False
        if password:
            if not sudoers_manager.setup():
                raise HTTPException(status_code=500, detail="sudo 免密配置失败，请检查密码是否正确")
            sudo_updated = True
[% endif %]
        return {
            "success": True,
            "message": "配置保存成功",
            "hot_reloaded": ["global_config.yaml"],
            "restart_required": ["ports.backend", "ports.frontend"],
[% if enable_sudo %]
            "sudo_updated": sudo_updated,
[% endif %]
        }
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"保存应用设置失败: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail=f"保存应用设置失败: {str(e)}")

[% if enable_sudo %]
@router.get("/config/check")
async def check_config():
    secrets_file = path_manager.get_config_path("secrets.yaml")

    if not secrets_file.exists():
        return {
            "valid": False,
            "reason": "config_not_found",
            "message": "密钥配置文件不存在",
            "config_path": str(secrets_file),
            "is_packaged": path_manager.is_packaged,
        }

    try:
        password = path_manager.get_config_value("sudo_password", config_file="secrets.yaml") or ""

        if not password:
            return {
                "valid": False,
                "reason": "password_empty",
                "message": "密码未设置",
                "config_path": str(secrets_file),
                "is_packaged": path_manager.is_packaged,
            }

        if not sudoers_manager.verify_password(password):
            return {
                "valid": False,
                "reason": "password_incorrect",
                "message": "密码不正确",
                "config_path": str(secrets_file),
                "is_packaged": path_manager.is_packaged,
            }

        sudoers_manager.setup()

        return {
            "valid": True,
            "message": "配置正常",
            "config_path": str(secrets_file),
            "is_packaged": path_manager.is_packaged,
        }
    except HTTPException:
        raise
    except Exception as e:
        return {
            "valid": False,
            "reason": "config_error",
            "message": f"配置文件错误: {str(e)}",
            "config_path": str(secrets_file),
            "is_packaged": path_manager.is_packaged,
        }


[% endif %]
[% if enable_sudo %]
@router.post("/config/save")
async def save_config(config_req: ConfigRequest):
    try:
        password = config_req.sudo_password.strip()
        logger.info("收到配置保存请求")

        if not password:
            raise HTTPException(status_code=400, detail="密码不能为空")

        _save_secret("sudo_password", password)

        if not sudoers_manager.setup():
            raise HTTPException(
                status_code=500, detail="sudo 免密配置失败，请检查密码是否正确"
            )

        return {"success": True, "message": "配置保存成功"}
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"保存配置失败: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail=f"保存配置失败: {str(e)}")


[% endif %]
class SecretUpdateRequest(BaseModel):
    key: str
    value: str


@router.post("/secrets/save")
async def save_secret(req: SecretUpdateRequest):
    """通用密钥保存接口，写入 secrets.yaml。"""
    try:
        if not req.key.strip() or not req.value.strip():
            raise HTTPException(status_code=400, detail="密钥名和值不能为空")

        _save_secret(req.key.strip(), req.value.strip())
        return {"success": True, "message": f"密钥 {req.key} 已保存"}
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"保存密钥失败: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail=f"保存密钥失败: {str(e)}")


@router.get("/files/list")
async def list_config_files():
    """获取所有配置文件列表"""
    try:
        config_dir = path_manager.get_config_dir()

        if not config_dir.exists():
            return {"files": []}

        yaml_files = []
        for file_path in config_dir.glob("*.yaml"):
            yaml_files.append(
                {
                    "name": file_path.name,
                    "filename": file_path.name,
                    "path": str(file_path),
                    "size": file_path.stat().st_size,
                    "modified": file_path.stat().st_mtime,
                }
            )

        return {
            "files": sorted(yaml_files, key=lambda x: x["filename"]),
            "config_dir": str(config_dir),
        }
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"获取配置文件列表失败: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail=f"获取文件列表失败: {str(e)}")


@router.get("/files/read/{filename}")
async def read_config_file(filename: str):
    """读取配置文件内容"""
    try:
        if not filename.endswith(".yaml"):
            raise HTTPException(status_code=400, detail="只支持 .yaml 文件")

        file_path = path_manager.get_config_path(filename)

        if not file_path.exists():
            raise HTTPException(status_code=404, detail=f"文件不存在: {filename}")

        with open(file_path, "r", encoding="utf-8") as f:
            content = f.read()

        is_valid, error_msg = path_manager.validate_yaml(content)

        return {
            "filename": filename,
            "content": content,
            "path": str(file_path),
            "is_valid": is_valid,
            "error": error_msg,
        }
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"读取文件失败: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail=f"读取文件失败: {str(e)}")


@router.post("/files/write")
async def write_config_file(req: FileContentRequest):
    """写入配置文件内容"""
    try:
        if not req.filename.endswith(".yaml"):
            raise HTTPException(status_code=400, detail="只支持 .yaml 文件")

        is_valid, error_msg = path_manager.validate_yaml(req.content)
        if not is_valid:
            raise HTTPException(status_code=400, detail=f"YAML 格式错误: {error_msg}")

        file_path = path_manager.get_config_path(req.filename)
        file_path.parent.mkdir(parents=True, exist_ok=True)

        backup_path = file_path.with_suffix(".yaml.bak")
        if file_path.exists():
            shutil.copy2(file_path, backup_path)
            logger.info(f"已备份配置文件: {backup_path}")

        with open(file_path, "w", encoding="utf-8") as f:
            f.write(req.content)

        path_manager.reload_config(req.filename)

        logger.info(f"配置文件已更新: {req.filename}")

        return {
            "success": True,
            "message": f"文件 {req.filename} 保存成功",
            "path": str(file_path),
        }
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"写入文件失败: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail=f"写入文件失败: {str(e)}")
