import os
import pathlib
import shutil
import sys
import yaml
from pathlib import Path

[% if enable_update %]

def _deep_merge_missing(dst: dict, src: dict, prefix: str = "") -> list:
    """把 src 中 dst 缺失的键递归补入 dst（已有值一律不覆盖），返回补齐的键路径。

    缺失的子树会递归展开到叶子再记录，日志能看到完整路径（如 test.test）。
    """
    added = []
    for key, value in src.items():
        path = f"{prefix}{key}"
        if isinstance(value, dict) and isinstance(dst.get(key), dict):
            added.extend(_deep_merge_missing(dst[key], value, prefix=f"{path}."))
        elif key not in dst:
            if isinstance(value, dict):
                dst[key] = {}
                added.extend(_deep_merge_missing(dst[key], value, prefix=f"{path}."))
            else:
                dst[key] = value
                added.append(path)
    return added
[% endif %]


class PathManager:
    def __init__(self, app_name: str = "[[ package_name]]"):
        self.app_name = app_name
        self.is_windows = os.name == "nt"
        self.is_mac = sys.platform == "darwin"
        self.is_packaged = bool(getattr(sys, "frozen", False))

        if self.is_packaged:
            # PyInstaller 二进制有两种部署形态：
            #   形式 2  /opt/Logging_tool/resources/server     deb 安装，资源/数据走 /opt + ~
            #   形式 3  <repo>/dist/server                      项目目录 dev，资源/数据全在 repo
            # 通过 sys.executable 实际路径判断；形式 3 完全独立于用户家目录，
            # 让形式 3 的运行时数据（configs/datas/logs）不会污染装好的 deb 用户配置
            exe_path = Path(sys.executable).resolve()
            in_project_dist = exe_path.parent.name.lower() == "dist"

            if in_project_dist:
                project_root = exe_path.parent.parent
                self.config_dir = project_root / "configs"
                self.data_dir = project_root / "datas"
                self.scripts_dir = project_root / "scripts"
                self.frontend_dir = project_root / "frontend" / "dist"
                self.bundled_configs_dir = project_root / "configs"
                self.bundled_scripts_dir = project_root / "scripts"
                self.firmwares_dir = project_root / "firmwares"
            else:
                resource_root = exe_path.parent
                if resource_root.name.lower() == "server-bin":
                    resource_root = resource_root.parent
                user_data_root = self._user_data_root()
                self.config_dir = self._user_config_dir()
                self.data_dir = user_data_root / "datas"
                install_root = resource_root
                self.scripts_dir = user_data_root / "scripts"
                self.frontend_dir = install_root / "frontend"
                self.bundled_configs_dir = install_root / "configs"
                self.bundled_scripts_dir = install_root / "scripts"
                self.firmwares_dir = install_root / "firmwares"

        else:
            project_root = Path(__file__).parent.parent.parent.resolve()
            self.config_dir = project_root / "configs"
            self.data_dir = project_root / "datas"
            self.logs_dir = self.data_dir / "logs"
            self.reports_dir = self.data_dir / "reports"
            self.scripts_dir = project_root / "scripts"
            self.frontend_dir = None
            self.bundled_configs_dir = None
            self.bundled_scripts_dir = None
            self.firmwares_dir = project_root / "firmwares"

        self.logs_dir = self.data_dir / "logs"
        self.reports_dir = self.data_dir / "reports"
        self._config_cache: dict[str, dict] = {}

    def get_config_path(self, filename: str) -> pathlib.Path:
        return self.config_dir / filename

    def get_config_dir(self) -> pathlib.Path:
        return self.config_dir

    def get_data_path(self, filename: str) -> pathlib.Path:
        return self.data_dir / filename

    def get_log_path(self, filename: str) -> pathlib.Path:
        return self.logs_dir / filename

    def get_report_path(self, filename: str) -> pathlib.Path:
        return self.reports_dir / filename

    def get_script_path(self, filename: str) -> pathlib.Path:
        return self.scripts_dir / filename

    def get_firmware_path(self, filename: str) -> pathlib.Path:
        return self.firmwares_dir / filename

    def _user_config_dir(self) -> Path:
        if self.is_windows:
            return Path(os.environ.get("APPDATA") or (Path.home() / "AppData/Roaming")) / self.app_name
        if self.is_mac:
            return Path.home() / "Library/Application Support" / self.app_name
        return Path.home() / ".config" / self.app_name

    def _user_data_root(self) -> Path:
        if self.is_windows:
            return Path(os.environ.get("LOCALAPPDATA") or os.environ.get("APPDATA") or (Path.home() / "AppData/Local")) / self.app_name
        if self.is_mac:
            return Path.home() / "Library/Application Support" / self.app_name
        return Path.home() / ".local/share" / self.app_name

    def get_frontend_path(self) -> pathlib.Path:
        return self.frontend_dir

    def load_config(self, config_file: str = "global_config.yaml") -> dict:
        if config_file in self._config_cache:
            return self._config_cache[config_file]

        config_path = self.get_config_path(config_file)

        try:
            if config_path.exists():
                with open(config_path, "r", encoding="utf-8") as f:
                    self._config_cache[config_file] = yaml.safe_load(f) or {}
            else:
                self._config_cache[config_file] = {}
            return self._config_cache[config_file]
        except Exception as e:
            print(f"加载配置失败 ({config_file}): {e}")
            self._config_cache[config_file] = {}
            return self._config_cache[config_file]

    def get_config_value(self, key: str, default=None, config_file: str = "global_config.yaml"):
        config = self.load_config(config_file)

        for k in key.split("."):
            if isinstance(config, dict):
                config = config.get(k)
                if config is None:
                    return default
            else:
                return default

[% if enable_update %]
        # 延迟导入：避免 -m 方式执行 secret_obfuscator 时与包初始化产生双导入警告
        from .secret_obfuscator import deobfuscate

        # 混淆值（obf1: 前缀）透明解密，业务代码无感知；明文值原样返回
        if isinstance(config, str):
            return deobfuscate(config)
        return config
[% else %]
        return config
[% endif %]

    def reload_config(self, config_file: str | None = None) -> None:
        if config_file is None:
            self._config_cache.clear()
        else:
            self._config_cache.pop(config_file, None)

    def init_user_data_dirs(self) -> None:
        """创建安装态运行数据目录；开发态目录由项目模板直接生成。"""
        if not self.is_packaged:
            return

        for directory in (self.data_dir, self.logs_dir, self.reports_dir):
            directory.mkdir(parents=True, exist_ok=True)

    def init_user_configs(self) -> list:
        """
        首次启动时把打包内置的 configs 目录递归拷贝到用户家目录。

        - 仅在打包态生效（开发态直接读项目目录的 configs/）
        - 不存在的文件：整体拷贝（.example 去后缀）
[% if enable_update %]
        - 已存在的 yaml 文件：递归补齐新版 example 中「用户新增的键」，
          已有的值一律不覆盖——新版本新增配置项时，老用户重启即自动获得
          默认值，无需手动迁移
[% else %]
        - 已存在的目标文件不覆盖（保留用户改动）
[% endif %]
        - 文件名以 .example 结尾的，拷贝时去掉该后缀

        返回本次发生变化的文件相对路径列表。
        """
        if not self.is_packaged:
            return []

        src_root = self.bundled_configs_dir
        if src_root is None or not src_root.exists():
            return []

        dst_root = self.config_dir

        # 项目目录跑 PyInstaller 二进制(形式 3)时,bundled 与用户 config 是同一个目录,
        # 不需要也不应该拷贝(否则 .example 会被去后缀拷到自己旁边)。
        try:
            if src_root.resolve() == dst_root.resolve():
                return []
        except OSError:
            pass

        dst_root.mkdir(parents=True, exist_ok=True)

        copied = []
        for src_path in src_root.rglob("*"):
            if not src_path.is_file():
                continue

            rel = src_path.relative_to(src_root)
            dst_name = rel.name
            if dst_name.endswith(".example"):
                dst_name = dst_name[: -len(".example")]
            dst_path = dst_root / rel.parent / dst_name

            if dst_path.exists():
[% if enable_update %]
                # 已存在的 yaml：补齐新版 example 中用户缺失的键（已有值不覆盖）
                if dst_path.suffix.lower() in (".yaml", ".yml"):
                    try:
                        src_data = yaml.safe_load(src_path.read_text(encoding="utf-8")) or {}
                        dst_data = yaml.safe_load(dst_path.read_text(encoding="utf-8")) or {}
                    except yaml.YAMLError:
                        continue
                    if not isinstance(src_data, dict) or not isinstance(dst_data, dict):
                        continue
                    added = _deep_merge_missing(dst_data, src_data)
                    if added:
                        shutil.copy2(dst_path, dst_path.with_suffix(dst_path.suffix + ".bak"))
                        dst_path.write_text(
                            yaml.safe_dump(dst_data, allow_unicode=True, sort_keys=False),
                            encoding="utf-8",
                        )
                        copied.append(
                            f"[补齐] {dst_path.relative_to(dst_root)}: {', '.join(added)}"
                        )
[% endif %]
                continue

            dst_path.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src_path, dst_path)
            copied.append(str(dst_path.relative_to(dst_root)))

        return copied
[% if enable_update %]

    def sync_declared_overwrites(self) -> list:
        """按 config_changes.json 声明的 overwrite 条目，用包内配置对齐用户文件。

        适用于「程序自带数据」类文件（如 csv）：内容以随包版本为权威，
        不参与用户自定义。与用户文件内容不一致时才覆盖（覆盖前留 .bak）。
        返回实际覆盖的文件名列表。
        """
        import json

        changes_path = self.get_config_path("config_changes.json")
        if not changes_path.exists():
            return []
        try:
            with open(changes_path, "r", encoding="utf-8") as f:
                changes = json.load(f) or {}
        except (OSError, ValueError):
            return []

        declared = set()
        for block in changes.values():
            for item in (block or {}).get("files") or []:
                if item.get("action") == "overwrite" and item.get("filename"):
                    declared.add(item["filename"])

        src_root = self.bundled_configs_dir
        if src_root is None or not src_root.exists():
            return []

        overwritten = []
        for name in sorted(declared):
            src_path = src_root / name
            dst_path = self.get_config_path(name)
            if not src_path.exists():
                continue
            try:
                # 包内与用户目录为同一位置时（项目目录直接跑二进制）无事可做
                if src_path.resolve() == dst_path.resolve():
                    continue
                src_text = src_path.read_text(encoding="utf-8")
                dst_text = dst_path.read_text(encoding="utf-8") if dst_path.exists() else None
            except OSError:
                continue
            if src_text == dst_text:
                continue
            if dst_path.exists():
                shutil.copy2(dst_path, dst_path.with_suffix(dst_path.suffix + ".bak"))
            dst_path.parent.mkdir(parents=True, exist_ok=True)
            dst_path.write_text(src_text, encoding="utf-8")
            overwritten.append(name)
        return overwritten
[% endif %]

    def init_user_scripts(self) -> list:
        """
        首次启动时把安装包内置 scripts 递归拷贝到用户数据根目录。

        - 仅在打包态生效（开发态直接使用项目根目录的 scripts/）
        - 目标 scripts/ 始终创建
        - 已存在的目标文件不覆盖

        返回本次新拷贝的脚本相对路径列表。
        """
        if not self.is_packaged:
            return []

        dst_root = self.scripts_dir
        dst_root.mkdir(parents=True, exist_ok=True)

        src_root = self.bundled_scripts_dir
        if src_root is None or not src_root.exists():
            return []

        try:
            if src_root.resolve() == dst_root.resolve():
                return []
        except OSError:
            pass

        copied = []
        for src_path in src_root.rglob("*"):
            if not src_path.is_file():
                continue

            rel = src_path.relative_to(src_root)
            dst_path = dst_root / rel
            if dst_path.exists():
                continue

            dst_path.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src_path, dst_path)
            copied.append(str(rel))

        return copied


path_manager = PathManager("[[ package_name]]")
