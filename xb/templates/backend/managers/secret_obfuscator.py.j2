"""配置文件敏感值的轻量混淆（防围观，非加密）。

secrets.yaml 会随安装包分发到产线机器，app_secret 等值以明文存放时，
任何打开该文件的人都能直接看到并冒用。这里提供一层最低限度的遮蔽：
XOR + Base64，落盘形如 ``obf1:xxxx``。

使用方式：
- 读取：``path_manager.get_config_value`` 检测到 ``obf1:`` 前缀会透明解密，
  业务代码无感知；
- 写入：``/api/secrets/save`` 对敏感键自动混淆；手工转换可用
  ``python -m managers.secret_obfuscator <明文>``。

诚实边界：混淆密钥内置在代码中，目的是防好奇围观，不防蓄意逆向。
"""

import base64
import shutil
import sys
from pathlib import Path

_PREFIX = "obf1:"
# 混淆密钥（防围观级别；与 scripts/feishu_upload.py 的解密 key 保持一致）
_KEY = b"[[ package_name ]]$SecretObfuscation#2026"
# 键名含这些标签的值视为敏感（大小写不敏感）
SENSITIVE_TAGS = ("secret", "password", "token")


def obfuscate(plain: str) -> str:
    """明文 -> "obf1:<base64>"。空值原样返回。"""
    if not plain:
        return plain or ""
    data = plain.encode("utf-8")
    xored = bytes(b ^ _KEY[i % len(_KEY)] for i, b in enumerate(data))
    return _PREFIX + base64.urlsafe_b64encode(xored).decode("ascii")


def deobfuscate(value) -> str:
    """带 obf1: 前缀的值解密还原；其余（明文/非字符串）原样返回。"""
    if not isinstance(value, str) or not value.startswith(_PREFIX):
        return value
    try:
        raw = base64.urlsafe_b64decode(value[len(_PREFIX):].encode("ascii"))
        return bytes(b ^ _KEY[i % len(_KEY)] for i, b in enumerate(raw)).decode("utf-8")
    except Exception:
        return ""  # 解不出来宁可给空值，也不能把密文当明文用


def obfuscate_plain_secrets(data: dict) -> tuple[dict, int]:
    """递归地把键名含敏感标签的明文值就地混淆，返回 (data, 混淆个数)。"""
    count = 0

    def walk(node):
        nonlocal count
        if not isinstance(node, dict):
            return
        for key, value in list(node.items()):
            if isinstance(value, dict):
                walk(value)
            elif (
                isinstance(value, str) and value
                and not value.startswith(_PREFIX)
                and any(tag in str(key).lower() for tag in SENSITIVE_TAGS)
            ):
                node[key] = obfuscate(value)
                count += 1

    walk(data)
    return data, count


def obfuscate_file_plain_secrets(path: Path) -> int:
    """就地混淆 YAML 文件中的明文敏感键。

    用于打包前处理 secrets.yaml.example、启动时兜底处理用户 secrets.yaml：
    明文填进去也没关系，处理后文件/安装包里就是密文。无变化不写盘，
    有变化先留 .bak 再原子替换。返回混淆的键个数。
    """
    import yaml

    path = Path(path)
    if not path.exists():
        return 0
    with open(path, "r", encoding="utf-8") as f:
        try:
            data = yaml.safe_load(f) or {}
        except yaml.YAMLError as e:
            print(f"⚠️ {path.name} 不是合法 YAML，跳过混淆: {e}")
            return 0

    migrated, count = obfuscate_plain_secrets(data)
    if count == 0:
        return 0

    backup = path.with_suffix(path.suffix + ".bak")
    shutil.copy2(path, backup)
    tmp_path = path.with_suffix(path.suffix + ".tmp")
    with open(tmp_path, "w", encoding="utf-8") as f:
        yaml.safe_dump(migrated, f, allow_unicode=True, sort_keys=False)
    tmp_path.replace(path)
    print(f"🔐 已混淆 {path.name} 中 {count} 个明文敏感键（备份: {backup.name}）")
    return count


def main(argv: list[str]) -> int:
    if argv and argv[0] == "--file":
        if len(argv) != 2:
            print("用法: python -m managers.secret_obfuscator --file <yaml路径>")
            return 1
        obfuscate_file_plain_secrets(Path(argv[1]))
        return 0
    if len(argv) == 1:
        print(obfuscate(argv[0]))
        return 0
    print(
        "用法:\n"
        "  python -m managers.secret_obfuscator <明文>        输出混淆值\n"
        "  python -m managers.secret_obfuscator --file <yaml> 就地混淆文件中的明文敏感键"
    )
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
