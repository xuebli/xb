import pathlib
import subprocess
import getpass
import tempfile
from datetime import datetime
from .logger_manager import get_logger
from .path_manager import path_manager

logger = get_logger(__name__)


class SudoersManager:
    def __init__(self, app_name: str = "[[ package_name_capitalized]]"):
        self.app_name = app_name
        self.sudoers_file = f"/etc/sudoers.d/{app_name}_nopasswd"
        self.commands = []
        self._is_setup = False

    def verify_password(self, password: str) -> bool:
        try:
            result = subprocess.run(
                ["sudo", "-k", "-S", "-p", "", "true"],
                input=f"{password}\n",
                capture_output=True,
                text=True,
                timeout=1,
            )
            return result.returncode == 0
        except subprocess.TimeoutExpired:
            return False
        except Exception as e:
            logger.error(f"验证密码异常: {e}")
            return False

    def _run_sudo_command(self, command: list, password: str) -> tuple:
        try:
            process = subprocess.Popen(
                ["sudo", "-k", "-S"] + command,
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
            )
            stdout, stderr = process.communicate(input=f"{password}\n", timeout=10)
            return (
                process.returncode == 0,
                stdout if process.returncode == 0 else stderr,
            )
        except Exception as e:
            return (False, str(e))

    def _generate_sudoers_content(self) -> str:
        lines = [
            f"# {self.app_name} sudo nopasswd configuration",
            f"# Generated on {datetime.now().isoformat()}",
            "",
        ]

        username = getpass.getuser()
        for cmd in self.commands:
            lines.append(f"{username} ALL=(ALL) NOPASSWD: {cmd}")

        return "\n".join(lines) + "\n"

    def setup(self) -> bool:
        if self._is_setup:
            return True

        logger.info("配置 sudo 免密...")

        password = path_manager.get_config_value("sudo_password")
        if not password:
            logger.error("未配置 sudo_password")
            return False

        content = self._generate_sudoers_content()

        with tempfile.NamedTemporaryFile(mode="w", delete=False) as tmp:
            tmp.write(content)
            tmp_path = tmp.name

        try:
            success, msg = self._run_sudo_command(
                [
                    "install",
                    "-o",
                    "root",
                    "-g",
                    "root",
                    "-m",
                    "0440",
                    tmp_path,
                    self.sudoers_file,
                ],
                password,
            )
            if not success:
                logger.error(f"安装失败: {msg}")
                return False

            success, msg = self._run_sudo_command(
                ["visudo", "-c", "-f", self.sudoers_file], password
            )
            if not success:
                logger.error(f"验证失败: {msg}")
                self._run_sudo_command(["rm", "-f", self.sudoers_file], password)
                return False

            self._is_setup = True
            logger.info("✓ sudo 免密配置成功")
            return True

        finally:
            pathlib.Path(tmp_path).unlink(missing_ok=True)

    def remove(self) -> bool:
        if not self._is_setup:
            return True

        logger.info("移除 sudo 免密配置...")
        password = path_manager.get_config_value("sudo_password")

        if not password:
            logger.error("未配置 sudo_password,无法移除")
            return False

        success, msg = self._run_sudo_command(["rm", "-f", self.sudoers_file], password)

        if success:
            self._is_setup = False
            logger.info("✓ sudo 免密已移除")
        else:
            logger.error(f"移除失败: {msg}")

        return success

    def is_configured(self) -> bool:
        return pathlib.Path(self.sudoers_file).exists()


sudoers_manager = SudoersManager("[[ package_name]]")
