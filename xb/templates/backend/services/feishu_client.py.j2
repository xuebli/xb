"""飞书云文档客户端 —— 自动更新所需的飞书开放平台接口封装。

职责（仅自动更新链路）：
- tenant_access_token 获取与缓存
- 云文档文件夹列举（检查更新用）
- 文件下载（并发分块 + 断点重试 + 进度回调）

配置项（secrets.yaml）：
    feishu:
      app_id: "cli_xxx"
      app_secret: "xxx"
      update_folder_url: "https://xxx.feishu.cn/drive/folder/<token>"
"""

import json
import threading
import time
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path
from typing import Optional

from managers import get_logger, path_manager

logger = get_logger(__name__)

BASE_URL = "https://open.feishu.cn/open-apis"


class FeishuClient:
    """飞书 API 客户端。"""

    def __init__(self):
        self._token: Optional[str] = None
        self._token_expires: float = 0

    @property
    def app_id(self) -> str:
        return path_manager.get_config_value("feishu.app_id", default="", config_file="secrets.yaml")

    @property
    def app_secret(self) -> str:
        return path_manager.get_config_value("feishu.app_secret", default="", config_file="secrets.yaml")

    def _get_tenant_access_token(self) -> str:
        """获取 tenant_access_token（带缓存）。"""
        if self._token and time.time() < self._token_expires:
            return self._token

        payload = {
            "app_id": self.app_id,
            "app_secret": self.app_secret,
        }
        data = json.dumps(payload).encode()
        req = urllib.request.Request(
            f"{BASE_URL}/auth/v3/tenant_access_token/internal",
            data=data,
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            result = json.loads(resp.read())
            if result.get("code") != 0:
                raise RuntimeError(f"获取 tenant_access_token 失败: {result}")
            self._token = result["tenant_access_token"]
            self._token_expires = time.time() + result.get("expire", 7200) - 300
            return self._token

    def _request(self, method: str, path: str, data: bytes = None, content_type: str = "application/json") -> dict:
        """发送 API 请求。飞书接口即使业务失败通常也返回 HTTP 200，必须检查 body 里的 code 字段。"""
        token = self._get_tenant_access_token()
        headers = {"Authorization": f"Bearer {token}"}
        if data and content_type:
            headers["Content-Type"] = content_type

        req = urllib.request.Request(f"{BASE_URL}{path}", data=data, headers=headers, method=method)
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                result = json.loads(resp.read())
        except urllib.error.HTTPError as exc:
            detail = exc.read().decode("utf-8", errors="replace")
            raise RuntimeError(f"请求 {path} HTTP {exc.code}: {detail}") from exc
        if result.get("code") != 0:
            raise RuntimeError(f"请求 {path} 失败: {result}")
        return result

    def list_folder_files(self, folder_token: str) -> list[dict]:
        """列举云文档文件夹下的文件，返回 [{token, name, type, modified_time, ...}]。

        用于应用内检查更新：同名文件每次上传都会生成新 token，调用方按
        name 过滤后取 modified_time 最大的那个。
        """
        files: list[dict] = []
        page_token = ""
        # page_size 官方上限 100（与 scripts/feishu_upload.py 一致），超限直接 HTTP 400
        while True:
            path = f"/drive/v1/files?folder_token={folder_token}&page_size=100"
            if page_token:
                path += f"&page_token={page_token}"
            result = self._request("GET", path)
            data = result.get("data", {})
            files.extend(data.get("files", []) or [])
            if not data.get("has_more"):
                break
            page_token = data.get("next_page_token", "")
            if not page_token:
                break
        return files

    def _open_download(self, file_token: str, range_header: str = None):
        """打开发布文件下载请求。range_header 形如 "bytes=0-8388607"。

        返回 (resp, raw_or_None)：响应是带非零 code 的飞书错误 JSON 时直接抛
        RuntimeError；是 application/json 业务文件时返回完整内容 raw（供小文件
        快速路径使用），否则 raw 为 None 由调用方流式读取。
        """
        token = self._get_tenant_access_token()
        headers = {"Authorization": f"Bearer {token}"}
        if range_header:
            headers["Range"] = range_header
        req = urllib.request.Request(
            f"{BASE_URL}/drive/v1/files/{file_token}/download",
            headers=headers,
            method="GET",
        )
        try:
            resp = urllib.request.urlopen(req, timeout=60)
        except urllib.error.HTTPError as exc:
            detail = exc.read().decode("utf-8", errors="replace")
            raise RuntimeError(f"下载文件 HTTP {exc.code}: {detail}") from exc

        if "application/json" in resp.headers.get("Content-Type", ""):
            raw = resp.read()
            try:
                maybe_error = json.loads(raw)
            except (json.JSONDecodeError, UnicodeDecodeError):
                maybe_error = None
            if (
                isinstance(maybe_error, dict)
                and isinstance(maybe_error.get("code"), int)
                and maybe_error["code"] != 0
            ):
                raise RuntimeError(f"下载文件失败: {maybe_error}")
            return resp, raw
        return resp, None

    def download_file(
        self,
        file_token: str,
        save_path: Path,
        progress_cb=None,
        workers: int = 4,
        chunk_size: int = 8 * 1024 * 1024,
    ) -> Path:
        """下载云文档文件到本地，可选进度回调 progress_cb(已下载, 总大小)。

        飞书开放平台对下载接口按文件限速（实测单连接 ~0.1MB/s），接口支持
        Range（HTTP 206），多线程分块并发约可提速 2 倍（受文件总配额限制，
        线程过多还可能触发风控，默认 4）。小文件/不支持 Range 时回退单流。
        先写 .part 临时文件，全部落盘后原子改名。
        """
        return self._download_impl(file_token, save_path, progress_cb, workers, chunk_size)

    def _download_impl(self, file_token, save_path, progress_cb, workers, chunk_size) -> Path:
        # 先发普通全量请求：拿到 Content-Length，同时天然规避「刚上传文件的
        # Range 读取不稳定」问题（9499/内容截断，飞书异步索引未生效所致）。
        resp, raw = self._open_download(file_token)
        status = getattr(resp, "status", 200)
        total = int(resp.headers.get("Content-Length") or 0)

        if raw is not None:
            # 业务 json 文件全量返回
            save_path.parent.mkdir(parents=True, exist_ok=True)
            save_path.write_bytes(raw)
            if progress_cb:
                progress_cb(len(raw), len(raw))
            return save_path
        if total and total <= 4 * 1024 * 1024:
            # 小二进制文件直接单流读完，不值得并发
            data = resp.read()
            resp.close()
            save_path.parent.mkdir(parents=True, exist_ok=True)
            save_path.write_bytes(data)
            if progress_cb:
                progress_cb(len(data), len(data))
            return save_path
        if not total:
            raise RuntimeError(f"下载文件失败: 无法获取文件大小 ({save_path.name})")
        resp.close()

        # 大文件：Range 探测确认并发可行性。零长度 Range（bytes=0-0）会被飞书
        # 以 9499 拒绝，探测块至少 1 字节。
        probe, _ = self._open_download(file_token, "bytes=0-1023")
        supports_range = getattr(probe, "status", 200) == 206
        probe.close()

        save_path.parent.mkdir(parents=True, exist_ok=True)
        tmp_path = save_path.with_suffix(save_path.suffix + ".part")
        # 预分配目标大小，各线程 seek 到自己的区间写入（多 fd 写同一文件不同区域是安全的）
        with open(tmp_path, "wb") as f:
            f.truncate(total)

        downloaded = [0]
        lock = threading.Lock()

        def report(n: int):
            with lock:
                downloaded[0] += n
                if progress_cb:
                    progress_cb(downloaded[0], total)

        def pull(start: int, end: int):
            """下载 [start, end] 闭区间块，失败按指数间隔重试。"""
            expect = end - start + 1
            last_err: Exception = RuntimeError("未执行")
            for attempt in range(4):
                try:
                    resp, raw = self._open_download(file_token, f"bytes={start}-{end}")
                    if raw is not None:
                        data = raw
                        pos = start
                        if len(data) != expect:
                            raise RuntimeError(f"块长度不符: {len(data)}/{expect}")
                        with open(tmp_path, "r+b") as f:
                            f.seek(pos)
                            f.write(data)
                        report(expect)
                        return
                    if getattr(resp, "status", 200) != 206:
                        raise RuntimeError("服务器未按 Range 返回 206")
                    pos = start
                    with open(tmp_path, "r+b") as f:
                        while True:
                            chunk = resp.read(256 * 1024)
                            if not chunk:
                                break
                            f.seek(pos)
                            f.write(chunk)
                            pos += len(chunk)
                            report(len(chunk))
                    if pos - start != expect:
                        raise RuntimeError(f"块不完整: {pos - start}/{expect}")
                    return
                except Exception as exc:  # noqa: BLE001
                    last_err = exc
                    time.sleep(min(2 ** attempt, 8))
            raise RuntimeError(f"分块 {start}-{end} 下载失败: {last_err}")

        ranges = [
            (s, min(s + chunk_size, total) - 1)
            for s in range(0, total, chunk_size)
        ]
        effective_workers = 1 if not supports_range else max(1, workers)
        with ThreadPoolExecutor(max_workers=effective_workers) as pool:
            futures = [pool.submit(pull, s, e) for s, e in ranges]
            for fut in as_completed(futures):
                fut.result()

        tmp_path.replace(save_path)
        return save_path


# 全局客户端实例
feishu_client = FeishuClient()
