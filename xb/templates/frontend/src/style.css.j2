:root {
  --bg: #f7fbff;
  --surface: rgba(255, 255, 255, 0.74);
  --surface-soft: rgba(255, 255, 255, 0.56);
  --text: #42526b;
  --text-h: #101828;
  --muted: #6677a0;
  --border: rgba(139, 92, 246, 0.18);
  --border-strong: rgba(34, 211, 238, 0.44);
  --accent: #7c3aed;
  --accent-dark: #5b21b6;
  --accent-soft: rgba(124, 58, 237, 0.12);
  --blue: #06b6d4;
  --blue-soft: rgba(34, 211, 238, 0.14);
  --amber: #f97316;
  --amber-soft: rgba(251, 146, 60, 0.16);
  --green: #10b981;
  --green-soft: rgba(16, 185, 129, 0.16);
  --shadow: 0 24px 80px rgba(124, 58, 237, 0.18);
  --shadow-soft: 0 16px 44px rgba(14, 165, 233, 0.12);
  --radius: 8px;
  --sans: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;

  font: 16px/1.5 var(--sans);
  color: var(--text);
  background: var(--bg);
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background: var(--bg);
  overflow-x: hidden;
}


.ambient-bg {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
  background:
    radial-gradient(circle at 20% 18%, rgba(125, 92, 255, 0.18), transparent 30%),
    radial-gradient(circle at 82% 20%, rgba(34, 211, 238, 0.16), transparent 28%),
    radial-gradient(circle at 72% 82%, rgba(16, 185, 129, 0.10), transparent 30%),
    linear-gradient(180deg, #fbfdff 0%, #f5faff 54%, #faf7ff 100%);
}

.ambient-bg::before {
  content: '';
  position: absolute;
  width: 58vmax;
  height: 58vmax;
  left: -18vmax;
  top: 18vh;
  border-radius: 999px;
  background: radial-gradient(circle, rgba(124, 58, 237, 0.12), transparent 62%);
  filter: blur(18px);
  animation: calm-orb-a 34s ease-in-out infinite alternate;
}

.ambient-bg::after {
  content: '';
  position: absolute;
  width: 54vmax;
  height: 54vmax;
  right: -16vmax;
  top: -12vmax;
  border-radius: 999px;
  background: radial-gradient(circle, rgba(34, 211, 238, 0.14), transparent 64%);
  filter: blur(20px);
  animation: calm-orb-b 40s ease-in-out infinite alternate;
}

.node,
.link {
  position: absolute;
  display: block;
}

.node {
  width: 4px;
  height: 4px;
  border-radius: 999px;
  background: rgba(124, 58, 237, 0.42);
  box-shadow: 0 0 12px rgba(124, 58, 237, 0.32);
  animation: calm-dot 18s ease-in-out infinite alternate;
}

.node-a { left: 14%; top: 30%; animation-delay: -1s; }
.node-b { left: 30%; top: 16%; animation-delay: -5s; }
.node-c { left: 50%; top: 42%; animation-delay: -9s; }
.node-d { left: 72%; top: 24%; animation-delay: -3s; }
.node-e { left: 84%; top: 62%; animation-delay: -7s; }
.node-f { left: 44%; top: 78%; animation-delay: -11s; }

.link {
  height: 1px;
  transform-origin: left center;
  background: linear-gradient(90deg, transparent, rgba(124, 58, 237, 0.16), rgba(34, 211, 238, 0.14), transparent);
  opacity: 0.28;
  animation: calm-link 12s ease-in-out infinite alternate;
}

.link::after {
  content: '';
  position: absolute;
  inset: -1px auto -1px 18%;
  width: 34px;
  border-radius: 999px;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.75), transparent);
  opacity: 0;
  animation: calm-glint 10s ease-in-out infinite;
}

.link-a { left: 14%; top: 31%; width: 220px; transform: rotate(-13deg); }
.link-b { left: 30%; top: 17%; width: 240px; transform: rotate(20deg); }
.link-c { left: 50%; top: 43%; width: 270px; transform: rotate(-8deg); }
.link-d { left: 71%; top: 26%; width: 220px; transform: rotate(30deg); }
.link-e { left: 44%; top: 79%; width: 280px; transform: rotate(-18deg); }

.app-shell > :not(.ambient-bg) {
  position: relative;
  z-index: 1;
}

@keyframes calm-orb-a {
  from { transform: translate3d(0, 0, 0) scale(1); opacity: 0.72; }
  to { transform: translate3d(8vw, -4vh, 0) scale(1.08); opacity: 0.9; }
}

@keyframes calm-orb-b {
  from { transform: translate3d(0, 0, 0) scale(1); opacity: 0.7; }
  to { transform: translate3d(-7vw, 5vh, 0) scale(1.06); opacity: 0.88; }
}

@keyframes calm-dot {
  from { transform: translate3d(-3px, -2px, 0) scale(0.92); opacity: 0.28; }
  to { transform: translate3d(4px, 3px, 0) scale(1.08); opacity: 0.62; }
}

@keyframes calm-link {
  from { opacity: 0.18; filter: saturate(0.9); }
  to { opacity: 0.48; filter: saturate(1.18); }
}

@keyframes calm-glint {
  0%, 28% { transform: translateX(-28px); opacity: 0; }
  42% { opacity: 0.5; }
  62%, 100% { transform: translateX(120px); opacity: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .ambient-bg::before,
  .ambient-bg::after,
  .node,
  .link,
  .link::after {
    animation: none;
  }
}

button, input, textarea { font: inherit; }
button { border: 0; }

code {
  font-family: var(--mono);
  color: #0f172a;
  background: #eef2f7;
  border: 1px solid #dbe3ee;
  border-radius: 6px;
  padding: 4px 8px;
  white-space: nowrap;
}

.app-shell {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 16px 28px;
  background: rgba(255, 255, 255, 0.62);
  border-bottom: 1px solid rgba(124, 58, 237, 0.16);
  backdrop-filter: blur(16px);
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
}

.brand-mark {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  background: linear-gradient(135deg, #7c3aed, #06b6d4);
  color: #fff;
  font-size: 1.15rem;
  font-weight: 800;
  box-shadow: var(--shadow-soft);
  overflow: hidden;
}

.brand-mark.has-icon {
  background: transparent;
  box-shadow: none;
}

.brand-mark img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

.brand-mark span {
  display: grid;
  place-items: center;
  width: 100%;
  height: 100%;
}

.brand-block h1 {
  margin: 0;
  color: var(--text-h);
  font-size: 1.12rem;
  line-height: 1.2;
}

.brand-block p {
  margin: 3px 0 0;
  color: var(--muted);
  font-size: 0.82rem;
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 10px;
}

.icon-button {
  width: 40px;
  height: 40px;
  display: inline-grid;
  place-items: center;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.66);
  color: #0f172a;
  cursor: pointer;
  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
}

.icon-button:hover {
  border-color: var(--border-strong);
  box-shadow: var(--shadow-soft);
  transform: translateY(-1px);
}

.workspace {
  width: min(1180px, calc(100% - 40px));
  min-height: calc(100vh - 108px);
  margin: 0 auto;
  padding: 34px 0 56px;
  display: grid;
  place-items: center;
}

.intro-shell {
  width: min(940px, 100%);
  margin: 0 auto;
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
  gap: 24px;
  align-items: stretch;
}

.intro-copy, .panel, .intro-panel {
  border: 1px solid rgba(124, 58, 237, 0.16);
  border-radius: var(--radius);
  background: rgba(255, 255, 255, 0.72);
  box-shadow: var(--shadow-soft);
  backdrop-filter: blur(18px);
}

.intro-copy {
  padding: 34px;
}

.eyebrow, .panel-kicker {
  color: #7c3aed;
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.intro-copy h2 {
  margin: 12px 0 14px;
  color: var(--text-h);
  font-size: 2.2rem;
  line-height: 1.12;
}

.intro-copy p {
  max-width: 720px;
  margin: 0;
  color: #526070;
}

.intro-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 26px;
}

.primary-action {
  min-height: 40px;
  padding: 0 16px;
  border-radius: 8px;
  background: linear-gradient(135deg, #7c3aed, #06b6d4);
  color: #fff;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 14px 28px rgba(124, 58, 237, 0.2), 0 6px 16px rgba(34, 211, 238, 0.14);
}

.primary-action:hover { filter: saturate(1.08) brightness(1.02); }

.intro-panel, .panel {
  padding: 24px;
}

.panel-heading h3 {
  margin: 6px 0 18px;
  color: var(--text-h);
  font-size: 1.2rem;
}

.stack-list {
  display: grid;
  gap: 10px;
}

.stack-row {
  display: grid;
  gap: 5px;
  padding: 12px 0;
  border-bottom: 1px solid var(--border);
}

.stack-row:last-child { border-bottom: 0; }
.stack-row strong { color: #111827; }
.stack-row span { color: #64748b; }



@media (max-width: 860px) {
  .topbar { align-items: flex-start; flex-direction: column; padding: 16px 20px; }
  .toolbar { width: 100%; justify-content: flex-start; flex-wrap: wrap; }
  .workspace { width: min(100% - 28px, 1180px); padding-top: 22px; }
  .intro-shell { width: 100%; grid-template-columns: 1fr; }
  .intro-copy { padding: 24px; }
}


.ambient-bg .link::after {
  content: '';
  position: absolute;
  inset: -1px auto -1px 0;
  width: 42px;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.95), transparent);
  animation: data-scan 4.8s linear infinite;
}

@keyframes data-scan {
  from { transform: translateX(-60px); opacity: 0; }
  20% { opacity: 1; }
  to { transform: translateX(340px); opacity: 0; }
}
