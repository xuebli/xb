<script setup>
import { computed, onMounted, ref } from 'vue'

// 后端基地址：开发态走 dev.py 注入的 VITE_API_BASE；打包态同源相对路径
const API_BASE = import.meta.env.VITE_API_BASE || ''

const loading = ref(true)
const saving = ref(false)
const error = ref('')
const message = ref('')
const schema = ref([])
const form = ref({})
const restartKeys = ref([])

const groups = computed(() => {
  const bySection = new Map()
  for (const field of schema.value) {
    const section = field.key.split('.')[0]
    if (!bySection.has(section)) bySection.set(section, [])
    bySection.get(section).push(field)
  }
  return [...bySection.entries()].map(([name, fields]) => ({ name, fields }))
})

const needsRestart = (field) => field.requires_restart && restartKeys.value.includes(field.key)

const load = async () => {
  loading.value = true
  error.value = ''
  try {
    const res = await fetch(`${API_BASE}/api/app-settings`)
    if (!res.ok) throw new Error(`HTTP ${res.status}`)
    const data = await res.json()
    schema.value = data.schema
    form.value = data.values
  } catch (e) {
    error.value = `配置加载失败: ${e.message}`
  } finally {
    loading.value = false
  }
}

const save = async () => {
  saving.value = true
  error.value = ''
  message.value = ''
  try {
    const res = await fetch(`${API_BASE}/api/app-settings`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ values: form.value }),
    })
    const data = await res.json()
    if (!res.ok) {
      error.value = data.error || `保存失败（HTTP ${res.status}）`
      return
    }
    form.value = data.values
    restartKeys.value = data.restart_required
    message.value = data.restart_required.length
      ? `已保存；${data.restart_required.join('、')} 需重启应用后生效`
      : '已保存并即时生效'
  } catch (e) {
    error.value = `保存失败: ${e.message}`
  } finally {
    saving.value = false
  }
}

onMounted(load)
</script>

<template>
  <div class="settings-view">
    <div class="settings-head">
      <div>
        <p class="settings-kicker">Settings</p>
        <h2>应用设置</h2>
      </div>
      <button class="settings-save" :disabled="saving || loading" @click="save">
        {{ saving ? '保存中...' : '保存配置' }}
      </button>
    </div>

    <div v-if="loading" class="settings-state">加载中...</div>
    <div v-else-if="error" class="settings-state settings-state--error">{{ error }}</div>

    <template v-else>
      <p v-if="message" class="settings-state settings-state--ok">{{ message }}</p>

      <section v-for="group in groups" :key="group.name" class="settings-card">
        <h3>{{ group.name }}</h3>
        <label v-for="field in group.fields" :key="field.key" class="settings-field">
          <span class="field-label" :title="field.key">
            {{ field.label }}
            <em v-if="field.secret" class="field-secret">密钥</em>
            <em v-if="needsRestart(field)" class="field-restart">需重启生效</em>
          </span>

          <select v-if="field.type === 'select'" v-model="form[field.key]">
            <option v-for="option in field.options" :key="option" :value="option">
              {{ option }}
            </option>
          </select>

          <label v-else-if="field.type === 'bool'" class="field-switch">
            <input v-model="form[field.key]" type="checkbox" />
            <span>{{ form[field.key] ? '开' : '关' }}</span>
          </label>

          <input
            v-else-if="field.type === 'int' || field.type === 'float'"
            v-model.number="form[field.key]"
            type="number"
            :min="field.min"
            :max="field.max"
            :step="field.type === 'float' ? 'any' : '1'"
          />

          <input
            v-else
            v-model="form[field.key]"
            :type="field.secret ? 'password' : 'text'"
            :autocomplete="field.secret ? 'new-password' : 'off'"
          />
        </label>
      </section>

      <p v-if="!schema.length" class="settings-state">
        global_config.yaml 里还没有业务配置项：在 yaml 里加 key 即会自动出现在这里，
        需要中文标签/校验范围时在 backend/api/settings.py 的 SETTINGS_SCHEMA 补元数据。
        密钥同理：在 secrets.yaml 里声明（值留空），这里会出现密码框。
      </p>
    </template>
  </div>
</template>

