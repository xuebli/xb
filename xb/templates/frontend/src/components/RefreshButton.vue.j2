  height: 40px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 0 14px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--surface);
  color: #0f172a;
  font-family: var(--sans);
  font-size: 0.92rem;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  user-select: none;
}

.refresh-button:hover:not(.is-disabled) {
  border-color: var(--border-strong);
  box-shadow: var(--shadow-soft);
  transform: translateY(-1px);
}

.refresh-button:active:not(.is-disabled) {
  transform: translateY(0);
  box-shadow: none;
}

.refresh-button:focus-visible {
  outline: 3px solid rgba(15, 118, 110, 0.18);
  outline-offset: 2px;
}

.refresh-button.is-disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.refresh-icon {
  width: 17px;
  height: 17px;
  transition: transform 0.6s ease;
}

.refresh-button.is-refreshing .refresh-icon {
  animation: spin 1s linear infinite;
}

.refresh-text { line-height: 1; }

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@media (max-width: 640px) {
  .refresh-text { display: none; }
  .refresh-button { width: 40px; padding: 0; justify-content: center; }
}

:root[data-theme='dark'] .refresh-button {
  color: #f1f5f9;
  background: rgba(30, 35, 50, 0.72);
}
