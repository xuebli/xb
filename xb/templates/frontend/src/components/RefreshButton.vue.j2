  padding: 20px;
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: flex-end;
  align-items: center;
  background: var(--bg);
}

@media (max-width: 1024px) {
  #refresh-bar {
    padding: 16px;
    justify-content: center;
  }
}
</style>

<style scoped>
