<script setup>
import { computed, onBeforeUnmount, onMounted, ref } from 'vue'

const LEVEL_RANK = { DEBUG: 10, INFO: 20, WARNING: 30, ERROR: 40, CRITICAL: 50 }
const BUFFER_MAX = 2000
const API_BASE = import.meta.env.VITE_API_BASE || ''

const connected = ref(false)
const minLevel = ref('DEBUG')
const keyword = ref('')
const autoScroll = ref(true)
const logs = ref([])
const logListEl = ref(null)

let source = null
let recentController = null
let lastSeq = 0
let unmounted = false

const filtered = computed(() => {
  const min = LEVEL_RANK[minLevel.value] ?? 0
  const kw = keyword.value.trim().toLowerCase()
  if (min <= 0 && !kw) return logs.value
  return logs.value.filter(
    (item) =>
      (LEVEL_RANK[item.level] ?? 20) >= min &&
      (!kw ||
        item.message.toLowerCase().includes(kw) ||
        item.source.toLowerCase().includes(kw)),
  )
})

const levelClass = (level) => `level--${level.toLowerCase()}`

const fmtTime = (ts) => {
  const d = new Date(ts * 1000)
  const pad = (n) => String(n).padStart(2, '0')
  return `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`
}

const nearBottom = () => {
  const el = logListEl.value
  if (!el) return true
  return el.scrollHeight - el.scrollTop - el.clientHeight < 48
}

const append = (item) => {
  const stick = autoScroll.value && nearBottom()
  logs.value.push(item)
  if (logs.value.length > BUFFER_MAX) {
    logs.value.splice(0, logs.value.length - BUFFER_MAX)
  }
  if (stick) {
    requestAnimationFrame(() => {
      const el = logListEl.value
      if (el) el.scrollTop = el.scrollHeight
    })
  }
}

const connect = () => {
  if (unmounted) return
  source?.close()
  source = new EventSource(`${API_BASE}/api/logs/stream?after=${lastSeq}`)
  source.onopen = () => {
    connected.value = true
  }
  // EventSource 断线自动重连，这里只负责状态展示
  source.onerror = () => {
    connected.value = false
  }
  source.onmessage = (event) => {
    connected.value = true
    const item = JSON.parse(event.data)
    lastSeq = item.seq
    append(item)
  }
}

const clearView = () => {
  logs.value = []
}

const exportLogs = () => {
  const text = filtered.value
    .map(
      (item) =>
        `[${new Date(item.ts * 1000).toISOString()}] [${item.level}] [${item.source}] ${item.message}`,
    )
    .join('\n')
  const blob = new Blob([text], { type: 'text/plain;charset=utf-8' })
  const url = URL.createObjectURL(blob)
  const link = document.createElement('a')
  link.href = url
  link.download = `logs-${new Date().toISOString().slice(0, 19).replace(/[T:]/g, '-')}.log`
  link.click()
  URL.revokeObjectURL(url)
}

onMounted(async () => {
  const controller = new AbortController()
  recentController = controller
  try {
    const res = await fetch(`${API_BASE}/api/logs/recent?limit=500`, {
      signal: controller.signal,
    })
    if (!res.ok) throw new Error(`HTTP ${res.status}`)
    const data = await res.json()
    if (!Array.isArray(data.logs)) throw new Error('最近日志响应格式错误')
    if (unmounted) return
    logs.value = data.logs
    lastSeq = Number.isFinite(data.last_seq) ? data.last_seq : 0
  } catch (e) {
    if (e.name !== 'AbortError') {
      // 后端未就绪：保留空数组，SSE 自动重连会兜底。
      logs.value = []
      lastSeq = 0
      console.error('加载最近日志失败:', e)
    }
  } finally {
    if (recentController === controller) recentController = null
  }
  if (!unmounted) connect()
})

onBeforeUnmount(() => {
  unmounted = true
  recentController?.abort()
  recentController = null
  source?.close()
  source = null
})
</script>

<template>
  <div class="logview">
    <div class="logview-header">
      <div>
        <p class="logview-kicker">Log Center</p>
        <h2>日志中心</h2>
      </div>
      <span class="logview-pill" :class="{ offline: !connected }">
        {{ connected ? '实时推送' : '重连中...' }}
      </span>
    </div>

    <div class="logview-toolbar">
      <select v-model="minLevel" class="logview-select" title="最低级别">
        <option value="DEBUG">DEBUG 及以上</option>
        <option value="INFO">INFO 及以上</option>
        <option value="WARNING">WARNING 及以上</option>
        <option value="ERROR">ERROR 及以上</option>
      </select>
      <input
        v-model="keyword"
        class="logview-input"
        type="search"
        placeholder="过滤关键词（消息 / 来源）"
      />
      <label class="logview-check">
        <input v-model="autoScroll" type="checkbox" />
        自动滚动
      </label>
      <button class="logview-button" @click="exportLogs">导出</button>
      <button class="logview-button" @click="clearView">清屏</button>
      <span class="logview-count">{{ filtered.length }} / {{ logs.length }} 条</span>
    </div>

    <div ref="logListEl" class="logview-list">
      <div v-if="!filtered.length" class="logview-empty">
        {{ logs.length ? '没有匹配的日志' : '暂无日志，触发一些操作试试' }}
      </div>
      <div v-for="item in filtered" :key="item.seq" class="logview-row">
        <span class="log-time">{{ fmtTime(item.ts) }}</span>
        <span class="log-level" :class="levelClass(item.level)">{{ item.level }}</span>
        <span class="log-source">{{ item.source }}</span>
        <pre class="log-message">{{ item.message }}</pre>
      </div>
    </div>
  </div>
</template>

