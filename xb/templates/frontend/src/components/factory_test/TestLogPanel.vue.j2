<script setup>
/** 测试日志面板：滚动展示执行日志 */
import { computed, nextTick, ref, watch } from 'vue'

const props = defineProps({
  logs: { type: Array, default: () => [] },
})

const logEl = ref(null)
const fullscreen = ref(false)
const fullscreenLogEl = ref(null)

const logEntries = computed(() => {
  const entries = []
  let current = null

  for (const [index, text] of props.logs.entries()) {
    if (/测试项 \d+\/\d+：/.test(text) || /测试项 \d+\/\d+:/.test(text)) {
      current = { start: index, failed: false }
      entries.push(current)
    } else if (current && /判定:\s*failed|测试失败/.test(text)) {
      current.failed = true
    }
  }

  return props.logs.map((text, index) => {
    const entry = [...entries].reverse().find((candidate) => candidate.start <= index)
    return { text, failed: Boolean(entry?.failed) }
  })
})

function scrollToBottom() {
  for (const el of [logEl.value, fullscreenLogEl.value]) {
    if (el) el.scrollTop = el.scrollHeight
  }
}

watch(
  () => props.logs.length,
  async () => {
    await nextTick()
    scrollToBottom()
  },
)
</script>

<template>
  <section class="log-card">
    <header class="log-header">
      <span>执行日志</span>
      <button type="button" class="log-fullscreen-btn" @click="fullscreen = true">⛶ 全屏查看</button>
    </header>
    <div ref="logEl" class="log-body">
      <div
        v-for="(entry, i) in logEntries"
        :key="i"
        class="log-line"
        :class="{ 'log-line-failed': entry.failed }"
      >{{ entry.text }}</div>
      <div v-if="!logs.length" class="log-empty">暂无日志</div>
    </div>
  </section>

  <Teleport to="body">
    <div v-if="fullscreen" class="log-fullscreen" @keydown.esc="fullscreen = false">
      <section class="log-fullscreen-card">
        <header class="log-header">
          <span>执行日志（全屏）</span>
          <button type="button" class="log-fullscreen-btn" @click="fullscreen = false">✕ 关闭</button>
        </header>
        <div ref="fullscreenLogEl" class="log-body log-fullscreen-body">
          <div
            v-for="(entry, i) in logEntries"
            :key="i"
            class="log-line"
            :class="{ 'log-line-failed': entry.failed }"
          >{{ entry.text }}</div>
          <div v-if="!logs.length" class="log-empty">暂无日志</div>
        </div>
      </section>
    </div>
  </Teleport>
</template>

