<script setup>
/** 分组测试项表格：展示一组测试项的执行状态 */
const props = defineProps({
  group: { type: Object, required: true },
})

const emit = defineEmits(['toggle-standalone'])

const STATUS_MAP = {
  pending: { icon: '⏳', label: '等待', cls: 'st-pending' },
  running: { icon: '🔄', label: '执行中', cls: 'st-running' },
  passed: { icon: '✅', label: '通过', cls: 'st-passed' },
  failed: { icon: '❌', label: '失败', cls: 'st-failed' },
  skipped: { icon: '⏭', label: '跳过', cls: 'st-skipped' },
}

function onToggleStandalone(item) {
  emit('toggle-standalone', item)
}
</script>

<template>
  <section class="group-card">
    <header class="group-header">
      <h3>{{ group.title }}</h3>
      <span v-if="group.description" class="group-desc">{{ group.description }}</span>
    </header>
    <table class="item-table">
      <thead>
        <tr>
          <th class="col-status">状态</th>
          <th class="col-name">测试功能</th>
          <th class="col-method">测试方法</th>
          <th class="col-std">PASS标准</th>
          <th class="col-standalone">单独测试</th>
          <th class="col-result">结果</th>
          <th class="col-duration">耗时</th>
        </tr>
      </thead>
      <tbody>
        <tr v-for="item in group.items.filter((i) => !i.hidden)" :key="item.id" :class="STATUS_MAP[item.status]?.cls">
          <td class="col-status">
            <span class="status-icon">{{ STATUS_MAP[item.status]?.icon }}</span>
            {{ STATUS_MAP[item.status]?.label }}
          </td>
          <td class="item-name">{{ item.name }}</td>
          <td class="col-method">{{ item.method }}</td>
          <td class="col-std">{{ item.pass_standard || '—' }}</td>
          <td class="col-standalone">
            <label class="standalone-checkbox">
              <input type="checkbox" :checked="item.standalone" @change="onToggleStandalone(item)" />
              <span class="checkmark"></span>
            </label>
          </td>
          <td class="col-result">
            <span v-if="item.actual_value" class="actual">{{ item.actual_value }}</span>
            {{ item.result_message }}
          </td>
          <td class="col-duration">{{ item.duration ? `${item.duration}s` : '' }}</td>
        </tr>
      </tbody>
    </table>
  </section>
</template>

