<script setup>
/** 人工确认模态框：测试暂停等待操作员确认时显示（人工确认/准备确认两种形态） */
import { ref } from 'vue'

const props = defineProps({
  itemName: { type: String, default: '' },
  method: { type: String, default: '' },
  commandKey: { type: String, default: '' },
  autoCheck: { type: Boolean, default: false },
})

const emit = defineEmits(['start', 'confirm', 'reject'])

const isExecuting = ref(false)

function handleStart() {
  isExecuting.value = true
  emit('start')
  setTimeout(() => {
    isExecuting.value = false
  }, 2000)
}
</script>

<template>
  <div class="manual-modal-overlay" @click.self="() => {}">
    <div class="manual-modal">
      <div class="manual-header">
        <span class="manual-icon">🔔</span>
        <div class="manual-title-group">
          <h2 class="manual-title">{{ autoCheck ? '准备确认' : '人工确认测试' }}</h2>
          <p class="manual-item-label">当前测试项</p>
          <p class="manual-item-name">{{ itemName }}</p>
        </div>
      </div>

      <div class="manual-body">
        <div class="manual-method" v-if="method">
          <div class="method-label">测试方法</div>
          <div class="method-content">{{ method }}</div>
        </div>
        <div class="manual-instruction">
          <template v-if="autoCheck">
            <p>1️⃣ 按测试方法完成准备工作（接线/放置工装等）</p>
            <p>2️⃣ 点击「开始测试」，系统自动执行指令并按 PASS 标准判定</p>
          </template>
          <template v-else>
            <p>1️⃣ 点击「开始测试」按钮，观察设备效果</p>
            <p>2️⃣ 可以多次点击「开始测试」重复观察</p>
            <p>3️⃣ 确认效果后，选择测试结果</p>
          </template>
        </div>
      </div>

      <div class="manual-actions">
        <button class="btn btn-start" @click="handleStart" :disabled="isExecuting">
          <span v-if="!isExecuting">▶️ 开始测试</span>
          <span v-else class="executing">
            <span class="spinner">⚙️</span>
            执行中...
          </span>
        </button>
        <button v-if="!autoCheck" class="btn btn-pass" @click="emit('confirm')" :disabled="isExecuting">
          ✅ 确认通过
        </button>
        <button v-if="!autoCheck" class="btn btn-fail" @click="emit('reject')" :disabled="isExecuting">
          ❌ 不通过
        </button>
      </div>
    </div>
  </div>
</template>

