<template>
  <div v-if="showConfig && requiresSudo" class="config-overlay">
    <div class="config-dialog">
      <aside class="config-sidebar">
        <div class="dialog-brand">⚒</div>
        <div class="sidebar-item active">🔐 Sudo 密码</div>
        <div class="sidebar-item muted">🌐 服务端口</div>
        <div class="sidebar-item muted">📄 YAML 配置</div>
      </aside>

      <section class="dialog-main">
        <header class="dialog-header">
          <div>
            <h2>配置中心</h2>
            <p>{{ configMessage }}</p>
          </div>
        </header>

        <div class="form-card">
          <div class="section-title">
            <h3>🔐 Sudo 密码</h3>
            <span>保存后立即配置免密权限</span>
          </div>

          <label class="field-row" for="password">
            <span>Sudo 密码 <b>*</b></span>
            <input
              type="password"
              id="password"
              v-model="password"
              placeholder="输入你的 sudo 密码"
              @keyup.enter="saveConfig"
              :disabled="saving"
            />
          </label>

          <div v-if="error" class="error">{{ error }}</div>

          <div class="meta-list">
            <div v-if="configPath"><span>配置文件</span><code>{{ configPath }}</code></div>
            <div v-if="isPackaged !== null"><span>当前模式</span><strong>{{ isPackaged ? '生产环境' : '开发环境' }}</strong></div>
          </div>
        </div>

        <footer class="dialog-footer">
          <span>✓ 配置仅保存在本机</span>
          <button @click="saveConfig" :disabled="!password || saving">
            {{ saving ? '保存中...' : '保存并启动' }}
          </button>
        </footer>
      </section>
    </div>
  </div>
</template>

<script setup>
import { ref, onMounted } from 'vue'

const showConfig = ref(false)
const requiresSudo = ref(true)
const password = ref('')
const saving = ref(false)
const error = ref('')
const configMessage = ref('检测到配置文件需要设置，请输入你的 sudo 密码')
const configPath = ref('')
const isPackaged = ref(null)
const API_BASE = import.meta.env.VITE_API_BASE || ''

const checkConfig = async () => {
  try {
    const response = await fetch(`${API_BASE}/api/config/check`)
    const result = await response.json()
    configPath.value = result.config_path || ''
    isPackaged.value = result.is_packaged
    requiresSudo.value = result.requires_sudo !== false

    if (requiresSudo.value && !result.valid) {
      showConfig.value = true
      configMessage.value = result.message || '配置无效'
    }
  } catch (err) {
    console.error('检查配置失败:', err)
    showConfig.value = true
    error.value = '无法连接后端服务，请稍后重试'
  }
}

const saveConfig = async () => {
  if (!requiresSudo.value) {
    showConfig.value = false
    return
  }
  if (!password.value) {
    error.value = '密码不能为空'
    return
  }

  saving.value = true
  error.value = ''

  try {
    const response = await fetch(`${API_BASE}/api/config/save`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ sudo_password: password.value })
    })
    const result = await response.json()

    if (response.ok && result.success) {
      showConfig.value = false
      window.location.reload()
    } else {
      error.value = result.detail || result.message || '保存失败'
    }
  } catch (err) {
    error.value = '保存失败: ' + err.message
  } finally {
    saving.value = false
  }
}

onMounted(() => {
  setTimeout(checkConfig, 500)
})
</script>

