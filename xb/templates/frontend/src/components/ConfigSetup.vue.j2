<template>
  <div v-if="showConfig" class="config-overlay">
    <div class="config-dialog">
      <h2>⚙️ 密码配置</h2>
      <p class="hint">{{ configMessage }}</p>
      
      <div class="form-group">
        <label for="password">Sudo 密码：</label>
        <input 
          type="password" 
          id="password" 
          v-model="password" 
          placeholder="输入你的 sudo 密码"
          @keyup.enter="saveConfig"
          :disabled="saving"
        />
      </div>
      
      <div v-if="error" class="error">{{ error }}</div>
      
      <div class="actions">
        <button @click="saveConfig" :disabled="!password || saving">
          {{ saving ? '保存中...' : '保存并启动' }}
        </button>
      </div>
      
      <div class="note">
        <p><strong>说明：</strong></p>
        <ul>
          <li>此密码用于创建 sudo 免密配置文件</li>
          <li>仅保存在本地配置文件中</li>
          <li v-if="configPath">配置文件位置: <code>{{ configPath }}</code></li>
          <li v-if="isPackaged !== null">
            当前模式: {{ isPackaged ? '生产环境' : '开发环境' }}
          </li>
        </ul>
      </div>
    </div>
  </div>
</template>

<script setup>
import { ref, onMounted } from 'vue'

const showConfig = ref(false)
const password = ref('')
const saving = ref(false)
const error = ref('')
const configMessage = ref('检测到配置文件需要设置，请输入你的 sudo 密码：')
const configPath = ref('')
const isPackaged = ref(null)

const checkConfig = async () => {
  try {
    const response = await fetch('http://localhost:8000/api/config/check')
    const result = await response.json()
    console.log('[ConfigSetup] 响应体完整内容:', JSON.stringify(result, null, 2))
    configPath.value = result.config_path || ''
    isPackaged.value = result.is_packaged

    if (!result.valid) {
      showConfig.value = true
      configMessage.value = result.message || '配置无效'
    }
  } catch (err) {
    console.error('检查配置失败:', err)
    showConfig.value = true
    error.value = '无法连接后端服务，请稍后重试'
  }
}

const saveConfig = async () => {
  if (!password.value) {
    error.value = '密码不能为空'
    return
  }
  
  saving.value = true
  error.value = ''
  
  try {
    const response = await fetch('http://localhost:8000/api/config/save', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        sudo_password: password.value
      })
    })
    
    const result = await response.json()
    
    if (response.ok && result.success) {
      showConfig.value = false
      window.location.reload()
    } else {
      error.value = result.detail || result.message || '保存失败'
    }
  } catch (err) {
    error.value = '保存失败: ' + err.message
  } finally {
    saving.value = false
  }
}

onMounted(() => {
  setTimeout(checkConfig, 500)
})
</script>

