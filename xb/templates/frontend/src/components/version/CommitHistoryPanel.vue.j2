<script setup>
import { computed } from 'vue'

const props = defineProps({
  commits: {
    type: Array,
    default: () => [],
  },
})

// 提交信息解析：第一行是标题（level -1），后续按缩进 2 空格一层
const parseCommitMessage = (message) => {
  if (!message) return []

  const lines = message.split('\n')
  const parsed = []
  let isFirstLine = true

  for (const line of lines) {
    if (!line.trim()) continue

    if (isFirstLine) {
      parsed.push({ level: -1, text: line.trim() })
      isFirstLine = false
      continue
    }

    const leadingSpaces = line.match(/^( *)/)[0].length
    const level = Math.floor(leadingSpaces / 2)
    const text = line.trim().replace(/^[-•○▪]\s*/, '')

    if (text) {
      parsed.push({ level, text })
    }
  }

  return parsed
}

const processedCommits = computed(() => {
  return props.commits.map((commit) => ({
    ...commit,
    parsedMessage: parseCommitMessage(commit.message)
  }))
})
</script>

<template>
  <div class="history-panel">
    <div class="block-title">📜 历史提交记录</div>

    <div class="commits-container">
      <div v-if="commits.length === 0" class="history-empty">
        暂无提交记录
      </div>

      <div v-else class="history-commits">
        <div v-for="c in processedCommits" :key="c.hash" class="history-commit">
          <div class="commit-header">
            <code class="commit-hash">{{ c.hash }}</code>
            <span class="commit-date">{{ c.date }}</span>
          </div>
          <div class="commit-body">
            <div
              v-for="(line, idx) in c.parsedMessage"
              :key="idx"
              :class="['msg-line', line.level === -1 ? 'level-title' : `level-${line.level}`]"
            >
              <span v-if="line.level === 0" class="msg-bullet">•</span>
              <span v-else-if="line.level === 1" class="msg-bullet sub">○</span>
              <span v-else-if="line.level >= 2" class="msg-bullet sub">▪</span>
              <span class="msg-text">{{ line.text }}</span>
            </div>
          </div>
          <div class="commit-author">{{ c.author }}</div>
        </div>
      </div>
    </div>
  </div>
</template>

