<script setup>
import { computed, ref, watch } from 'vue'
import { useUpdate } from '../../composables/useUpdate'

const {
  currentVersion,
  hasUpdate,
  latestVersion,
  releaseDate,
  releaseNotes,
  hasConfigChanges,
  configSummary,
  configFiles,
  downloadUrl,
  fileSize,
  source,
  canDownload,
  packaged,
  loading,
  error,
  downloadState,
  downloadEtaSeconds,
  installing,
  formatFileSize,
  checkUpdate,
  startDownload,
  installUpdate,
} = useUpdate()

const showUpdateDialog = ref(false)
const installMessage = ref('')

const status = computed(() => downloadState.value.status)
const busy = computed(() => ['downloading', 'verifying'].includes(status.value))

// 配置迁移明细：按版本块分组（一个版本一个版本展示）
const configChangeGroups = computed(() => {
  const groups = []
  const byVersion = new Map()
  for (const file of configFiles.value) {
    const version = file.block_version || '未知版本'
    if (!byVersion.has(version)) {
      const group = { version, files: [] }
      byVersion.set(version, group)
      groups.push(group)
    }
    byVersion.get(version).files.push(file)
  }
  return groups
})

// 迁移动作的中文标签
function actionLabel(action) {
  return { merge: '增量合并', create: '新建文件', overwrite: '整体覆盖' }[action] || action
}

// 密文值（obf1: 开头）不直接展示，统一描述为“来自随包模板”
function isObfuscated(value) {
  return typeof value === 'string' && value.startsWith('obf1:')
}

// 把一个文件条目的操作项翻译成大白话明细
function fileOperations(file) {
  const ops = []
  for (const item of file.overwrite_items || []) {
    if (typeof item === 'string') {
      ops.push(`删除 ${item}`)
    } else if ('value' in item && item.value && !isObfuscated(item.value)) {
      ops.push(`修改 ${item.key} → ${item.value}`)
    } else {
      ops.push(`将 ${item.key} 与随包模板对齐`)
    }
  }
  for (const item of file.delete_items || []) {
    ops.push(`删除 ${item}`)
  }
  for (const item of file.add_items || []) {
    if ('value' in item && item.value && !isObfuscated(item.value)) {
      ops.push(`新增 ${item.key} = ${item.value}`)
    } else {
      ops.push(`自动补齐 ${item.key}（值来自随包模板）`)
    }
  }
  return ops
}

// 自动检查发现新版本时弹一次；用户点「稍后提醒」关掉后不再打扰，
// 直到下次手动点「检查更新」按钮。
watch(hasUpdate, (newVal, oldVal) => {
  if (newVal && !oldVal) {
    showUpdateDialog.value = true
  }
})

// 手动检查更新：强制跳过后端缓存，有更新就开弹窗（不能依赖 watch，
// 因为 hasUpdate 已经是 true 时值不变，watch 不会触发）
async function handleCheckUpdate() {
  if (loading.value) return
  const data = await checkUpdate(true)
  if (data && !data.packaged) {
    alert('当前为开发模式（源码运行），更新功能仅在打包安装版中可用')
    return
  }
  if (data && data.has_update) {
    showUpdateDialog.value = true
  } else if (error.value) {
    alert(`检查更新失败：${error.value}`)
  } else {
    alert('当前已是最新版本')
  }
}

// 关闭更新提示弹窗（稍后提醒）
function dismissUpdate() {
  if (busy.value || installing.value) return
  showUpdateDialog.value = false
}

// 应用内下载（走后端代理 + 哈希校验）
async function handleDownload() {
  installMessage.value = ''
  await startDownload()
}

// 浏览器打开下载页（远程信息里没有 file_token 时的兜底）
function openDownloadPage() {
  if (downloadUrl.value) {
    window.open(downloadUrl.value, '_blank')
  }
}

// 备份配置 → 应用配置变更 → 拉起安装程序 → 关闭应用
async function handleInstall() {
  const result = await installUpdate(true)
  if (!result) {
    installMessage.value = `安装失败：${error.value}`
    return
  }
  const failed = (result.config_results || []).filter((item) => !item.success)
  if (failed.length > 0) {
    console.warn('部分配置变更未应用:', failed)
  }
  installMessage.value = '安装程序已启动，应用即将关闭，请稍候...'
  // 安装器要替换正在运行的文件，必须先退出应用；close 会走主进程的退出确认流程
  setTimeout(() => window.close(), 1500)
}

defineExpose({ hasUpdate, loading, latestVersion, handleCheckUpdate })
</script>

<template>
  <!-- 更新提示弹窗（由父组件标题行的「检查更新」按钮触发） -->
  <Teleport to="body">
      <div v-if="showUpdateDialog" class="update-modal" @click.self="dismissUpdate">
        <div class="update-modal-content">
          <div class="update-modal-header">
            <h3>发现新版本 v{{ latestVersion }}</h3>
            <button @click="dismissUpdate" class="close-btn">✕</button>
          </div>

          <div class="update-modal-body">
            <!-- 版本信息 -->
            <div class="update-info-section">
              <div class="info-row">
                <span class="info-label">当前版本:</span>
                <span class="info-value">v{{ currentVersion }}</span>
              </div>
              <div class="info-row">
                <span class="info-label">最新版本:</span>
                <span class="info-value highlight">v{{ latestVersion }}</span>
              </div>
              <div v-if="releaseDate" class="info-row">
                <span class="info-label">发布时间:</span>
                <span class="info-value">{{ releaseDate }}</span>
              </div>
              <div v-if="fileSize" class="info-row">
                <span class="info-label">文件大小:</span>
                <span class="info-value">{{ formatFileSize(fileSize) }}</span>
              </div>
            </div>

            <!-- 更新内容 -->
            <div v-if="releaseNotes" class="update-notes-section">
              <h4>更新内容</h4>
              <div class="notes-content">{{ releaseNotes }}</div>
            </div>

            <!-- 配置文件变更：按版本块分组，逐条列出迁移内容 -->
            <div v-if="hasConfigChanges" class="config-changes-section">
              <h4>⚠️ 配置文件变更</h4>
              <div v-if="configSummary" class="config-summary">{{ configSummary }}</div>

              <div class="config-files-list">
                <div
                  v-for="group in configChangeGroups"
                  :key="group.version"
                  class="config-version-group"
                >
                  <div class="version-title">
                    📌 {{ group.version }} 及以下版本升级时，需要做以下配置调整
                  </div>
                  <div
                    v-for="(file, index) in group.files"
                    :key="index"
                    class="config-file-item"
                  >
                    <div class="file-header">
                      <span class="file-icon">📄</span>
                      <span class="file-name">{{ file.filename }}</span>
                      <span class="file-action" :class="file.action">
                        {{ actionLabel(file.action) }}
                      </span>
                    </div>
                    <div v-if="file.description" class="file-description">
                      {{ file.description }}
                    </div>
                    <ul
                      v-if="fileOperations(file).length"
                      class="file-operations"
                    >
                      <li
                        v-for="(op, i) in fileOperations(file)"
                        :key="i"
                        class="operation-item"
                      >
                        {{ op }}
                      </li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>

            <!-- 备份提示 -->
            <div class="backup-notice">
              <span class="notice-icon">💡</span>
              <span>安装前会自动备份配置到 datas/config_backups</span>
            </div>

            <!-- 下载进度 -->
            <div v-if="busy || status === 'done' || status === 'error'" class="download-section">
              <div class="download-bar">
                <div
                  class="download-bar-fill"
                  :class="{ error: status === 'error' }"
                  :style="{ width: `${status === 'done' ? 100 : downloadState.progress}%` }"
                ></div>
              </div>
              <div class="download-status">
                <span v-if="status === 'downloading'">
                  下载中 {{ downloadState.progress }}%
                  ({{ formatFileSize(downloadState.downloaded) }} /
                  {{ formatFileSize(downloadState.total) }})
                  <span v-if="downloadEtaSeconds !== null">
                    · 预计剩余 {{ Math.max(1, Math.round(downloadEtaSeconds / 60)) }} 分钟
                  </span>
                </span>
                <span v-else-if="status === 'verifying'">校验安装包...</span>
                <span v-else-if="status === 'done'">✅ 安装包已就绪</span>
                <span v-else-if="status === 'error'" class="download-error">
                  ❌ {{ downloadState.error || error }}
                </span>
              </div>
            </div>

            <!-- 离线/无直链提示 -->
            <div v-if="!canDownload" class="backup-notice warn">
              <span class="notice-icon">⚠️</span>
              <span v-if="source === 'local'">
                当前读取的是本地兜底版本信息（未连上飞书），无法在应用内下载
              </span>
              <span v-else>版本信息缺少 file_token，无法在应用内下载，请手动下载安装</span>
            </div>

            <div v-if="installMessage" class="backup-notice">
              <span class="notice-icon">📦</span>
              <span>{{ installMessage }}</span>
            </div>
          </div>

          <div class="update-modal-footer">
            <button
              @click="dismissUpdate"
              class="btn btn-secondary"
              :disabled="busy || installing"
            >
              稍后提醒
            </button>
            <button v-if="!canDownload" @click="openDownloadPage" class="btn btn-primary">
              前往下载
            </button>
            <button
              v-else-if="status === 'done'"
              @click="handleInstall"
              class="btn btn-primary"
              :disabled="installing"
            >
              {{ installing ? '正在准备...' : '立即安装更新' }}
            </button>
            <button
              v-else
              @click="handleDownload"
              class="btn btn-primary"
              :disabled="busy"
            >
              {{ busy ? '下载中...' : status === 'error' ? '重试下载' : '下载并安装' }}
            </button>
          </div>
        </div>
      </div>
    </Teleport>
</template>

