<script setup>
import { ref, onMounted, onBeforeUnmount, nextTick } from 'vue'
import { Terminal } from '@xterm/xterm'
import { FitAddon } from '@xterm/addon-fit'
import '@xterm/xterm/css/xterm.css'

const BASE = import.meta.env.VITE_API_BASE || ''

const connected = ref(false)
const connecting = ref(false)

let term = null
let fitAddon = null
let ws = null
let resizeObserver = null
let fitFrame = 0
let dprQuery = null
let dprHandler = null
const termRef = ref(null)

function getWsUrl() {
  const proto = location.protocol === 'https:' ? 'wss:' : 'ws:'
  const base = BASE.replace(/^https?:\/\//, '') || location.host
  return `${proto}//${base}/api/terminal/ws`
}

function initTerminal() {
  if (term) {
    term.dispose()
  }

  term = new Terminal({
    cursorBlink: true,
    cursorStyle: 'block',
    fontSize: 14,
    fontFamily: "'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace",
    theme: {
      background: '#0a0e17',
      foreground: '#e4e8f0',
      cursor: '#3b82f6',
      selectionBackground: 'rgba(59,130,246,0.3)',
      black: '#1e2740',
      red: '#ef4444',
      green: '#22c55e',
      yellow: '#f59e0b',
      blue: '#3b82f6',
      magenta: '#8b5cf6',
      cyan: '#06b6d4',
      white: '#e4e8f0',
      brightBlack: '#5a6478',
      brightRed: '#fca5a5',
      brightGreen: '#86efac',
      brightYellow: '#fde047',
      brightBlue: '#93c5fd',
      brightMagenta: '#c4b5fd',
      brightCyan: '#67e8f9',
      brightWhite: '#f8fafc',
    },
    allowProposedApi: true,
  })

  fitAddon = new FitAddon()
  term.loadAddon(fitAddon)

  if (termRef.value) {
    term.open(termRef.value)
  }

  term.onData((data) => {
    if (ws && ws.readyState === WebSocket.OPEN) {
      ws.send(data)
    }
  })
}

function connect() {
  if (ws) {
    ws.close()
    ws = null
  }

  connected.value = false
  connecting.value = true

  if (term) {
    term.clear()
    term.reset()
  }

  const url = getWsUrl()
  ws = new WebSocket(url)

  ws.onopen = () => {
    connecting.value = false
    connected.value = true
  }

  ws.onmessage = (event) => {
    if (term) {
      term.write(event.data)
    }
  }

  ws.onclose = () => {
    connected.value = false
    connecting.value = false
    if (term) {
      term.write('\r\n\x1b[90m--- 连接已断开 ---\x1b[0m\r\n')
    }
  }

  ws.onerror = () => {
    connected.value = false
    connecting.value = false
    if (term) {
      term.write('\r\n\x1b[31m连接失败，请检查后端服务是否正常运行\x1b[0m\r\n')
    }
  }
}

function disconnect() {
  if (ws) {
    ws.close()
    ws = null
  }
  connected.value = false
}

function scheduleFit() {
  if (fitFrame) {
    cancelAnimationFrame(fitFrame)
  }
  fitFrame = requestAnimationFrame(() => {
    fitFrame = 0
    if (!term || !fitAddon || !termRef.value) return
    if (!term.element || !term.element.parentElement) return

    const { width, height } = termRef.value.getBoundingClientRect()
    if (width < 2 || height < 2) return

    fitAddon.fit()
  })
}

// 浏览器缩放只改变 devicePixelRatio，不触发 window.resize，必须用 matchMedia 单独监听
function watchDevicePixelRatio() {
  if (dprQuery && dprHandler) {
    dprQuery.removeEventListener('change', dprHandler)
  }
  dprQuery = window.matchMedia(`screen and (resolution: ${window.devicePixelRatio}dppx)`)
  dprHandler = () => {
    scheduleFit()
    watchDevicePixelRatio()
  }
  dprQuery.addEventListener('change', dprHandler)
}

onMounted(async () => {
  initTerminal()
  await nextTick()

  if (termRef.value) {
    resizeObserver = new ResizeObserver(scheduleFit)
    resizeObserver.observe(termRef.value)
  }
  window.addEventListener('resize', scheduleFit)
  watchDevicePixelRatio()
  scheduleFit()

  connect()
})

onBeforeUnmount(() => {
  resizeObserver?.disconnect()
  resizeObserver = null
  window.removeEventListener('resize', scheduleFit)
  if (dprQuery && dprHandler) {
    dprQuery.removeEventListener('change', dprHandler)
  }
  dprQuery = null
  dprHandler = null
  if (fitFrame) {
    cancelAnimationFrame(fitFrame)
    fitFrame = 0
  }
  if (ws) {
    ws.close()
    ws = null
  }
  if (term) {
    term.dispose()
    term = null
  }
})
</script>

<template>
  <div class="terminal-page">
    <div class="terminal-toolbar">
      <div class="toolbar-left">
        <span class="terminal-title">终端</span>
        <span class="terminal-hint">可在此运行 opencode / codex 等 AI 工具</span>
      </div>
      <div class="toolbar-right">
        <span class="status-indicator" :class="{ on: connected, connecting: connecting }">
          {{ connecting ? '连接中...' : connected ? '已连接' : '未连接' }}
        </span>
        <button v-if="!connected" class="tool-btn connect-btn" @click="connect" :disabled="connecting">
          连接
        </button>
        <button v-else class="tool-btn disconnect-btn" @click="disconnect">
          断开
        </button>
      </div>
    </div>
    <div class="terminal-container" ref="termRef"></div>
  </div>
</template>

