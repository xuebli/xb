<template>
  <div class="settings-page">
    <div class="page-head">
      <nav class="settings-tabs">
        <button :class="{ active: activeMode === 'form' }" @click="activeMode = 'form'">🌐 应用配置</button>
        <button :class="{ active: activeMode === 'secrets' }" @click="activeMode = 'secrets'">🔐 密钥管理</button>
      </nav>
    </div>

    <div class="page-body">
      <main class="settings-main">
        <section v-if="activeMode === 'form'" class="settings-panel">
          <div class="content-header">
            <div>
              <h3>🌐 应用配置</h3>
              <p>保存后会写入对应配置文件；可热重载项会立即刷新缓存。</p>
            </div>
            <button class="save-top" @click="saveSettings" :disabled="settingsSaving || settingsLoading">
              {{ settingsSaving ? '保存中...' : '保存配置' }}
            </button>
          </div>

          <div class="settings-content">
            <div v-if="settingsLoading" class="state-text">加载中...</div>
            <div v-else-if="settingsError" class="validation-error">{{ settingsError }}</div>
            <template v-else>
              <section class="settings-section">
                <h4>🔌 服务端口</h4>
                <p class="section-hint">端口保存后会刷新配置缓存，但 dev.py / Electron 监听端口需要重启进程才会接管。</p>
                <label class="field-row">
                  <span>后端端口</span>
                  <input v-model.number="settingsForm.ports.backend" type="number" min="1" max="65535" />
                </label>
                <label class="field-row">
                  <span>前端端口</span>
                  <input v-model.number="settingsForm.ports.frontend" type="number" min="1" max="65535" />
                </label>
              </section>

              <div v-if="settingsMessage" class="settings-message">{{ settingsMessage }}</div>
              <div v-if="settingsPath" class="path-strip">{{ settingsPath }}</div>
            </template>
          </div>
        </section>

        <section v-else-if="activeMode === 'secrets'" class="settings-panel">
          <div class="content-header">
            <div>
              <h3>🔐 密钥管理</h3>
              <p>敏感信息存储在 secrets.yaml，不会提交到 git。</p>
            </div>
          </div>

          <div class="settings-content">
            <p class="section-hint">后续接入的密钥（邮件、云服务等）可在此统一管理。</p>
          </div>
          <div v-if="secretsPath" class="path-strip">{{ secretsPath }}</div>
        </section>
      </main>
    </div>
  </div>
</template>

<script setup>
import { ref, onMounted, onUnmounted } from 'vue'

// 后端基地址：开发态走 dev.py 注入的 VITE_API_BASE；
// 打包态由 backend 直接当静态服务器返回页面，同源访问用相对路径即可
const API_BASE = import.meta.env.VITE_API_BASE || ''

const activeMode = ref('form')
const settingsLoading = ref(false)
const settingsSaving = ref(false)
const settingsError = ref('')
const settingsMessage = ref('')
const settingsPath = ref('')
const secretsPath = ref('')
const settingsForm = ref({
  ports: {
    backend: 8000,
    frontend: 5173
  }
})
let settingsMessageTimer

const showSavedMessage = (messageRef) => {
  clearTimeout(settingsMessageTimer)
  messageRef.value = '已保存'
  settingsMessageTimer = setTimeout(() => { messageRef.value = '' }, 3000)
}

const loadSettings = async () => {
  settingsLoading.value = true
  settingsError.value = ''

  try {
    const response = await fetch(`${API_BASE}/api/settings`)
    const data = await response.json()
    if (!response.ok) throw new Error(data.detail || '读取应用配置失败')

    settingsPath.value = data.config_path || ''
    secretsPath.value = data.secrets_path || ''
    settingsForm.value = {
      ports: {
        backend: data.ports?.backend || 8000,
        frontend: data.ports?.frontend || 5173
      }
    }
  } catch (e) {
    settingsError.value = e.message
    console.error('读取应用配置失败:', e)
  } finally {
    settingsLoading.value = false
  }
}

const saveSettings = async () => {
  settingsSaving.value = true
  settingsError.value = ''
  settingsMessage.value = ''

  try {
    const response = await fetch(`${API_BASE}/api/settings`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(settingsForm.value)
    })
    const data = await response.json()
    if (!response.ok) throw new Error(data.detail || '保存应用配置失败')

    await loadSettings()
    showSavedMessage(settingsMessage)
  } catch (e) {
    settingsError.value = e.message
    console.error('保存应用配置失败:', e)
  } finally {
    settingsSaving.value = false
  }
}

onMounted(() => {
  loadSettings()
})

onUnmounted(() => {
  clearTimeout(settingsMessageTimer)
})
</script>

