<template>
  <div v-if="showManager" class="file-overlay" @click="closeIfOutside">
    <div class="file-dialog" @click.stop>
      <div class="dialog-header">
        <h2>⚙️ 配置文件管理</h2>
        <button class="close-btn" @click="close">×</button>
      </div>

      <div class="dialog-body">
        <div class="file-list">
          <div class="mode-tabs">
            <button :class="{ active: activeMode === 'form' }" @click="activeMode = 'form'">表单配置</button>
            <button :class="{ active: activeMode === 'yaml' }" @click="activeMode = 'yaml'">原始 YAML</button>
          </div>
          <template v-if="activeMode === 'yaml'">
          <h3>配置文件列表</h3>
          <div v-if="loading" class="loading">加载中...</div>
          <div v-else-if="error" class="error">{{ error }}</div>
          <div v-else-if="files.length === 0" class="empty">暂无配置文件</div>
          <div v-else class="files">
            <div
              v-for="file in files"
              :key="file.filename"
              class="file-item"
              :class="{ active: selectedFile?.filename === file.filename }"
              @click="loadFile(file.filename)"
            >
              <div class="file-icon">📄</div>
              <div class="file-info">
                <div class="file-name">{{ file.filename }}</div>
                <div class="file-meta">{{ formatSize(file.size) }} · {{ formatTime(file.modified) }}</div>
              </div>
            </div>
          </div>
          </template>
        </div>

        <div class="file-editor">
          <div v-if="activeMode === 'form'" class="settings-panel">
            <div class="editor-header">
              <h3>应用配置</h3>
              <div class="editor-actions">
                <button @click="saveSettings" :disabled="settingsSaving || settingsLoading">
                  {{ settingsSaving ? '保存中...' : '保存配置' }}
                </button>
              </div>
            </div>

            <div class="settings-content">
              <div v-if="settingsLoading" class="loading">加载中...</div>
              <div v-else-if="settingsError" class="validation-error">{{ settingsError }}</div>
              <template v-else>
                [% if enable_sudo %]
                <section class="settings-section">
                  <h4>Sudo 密码</h4>
                  <p class="section-hint">留空表示不修改当前密码；填写后会立即更新 sudo 免密配置。</p>
                  <label class="field-row">
                    <span>密码</span>
                    <input
                      v-model="settingsForm.sudo_password"
                      type="password"
                      placeholder="不修改请留空"
                      autocomplete="current-password"
                    />
                  </label>
                </section>
                [% endif %]

                <section class="settings-section">
                  <h4>服务端口</h4>
                  <p class="section-hint">端口会写入 global_config.yaml；保存后已刷新配置缓存，但 dev.sh / Electron 端口变更需要重启进程才会接管。</p>
                  <label class="field-row">
                    <span>后端端口</span>
                    <input v-model.number="settingsForm.ports.backend" type="number" min="1" max="65535" />
                  </label>
                  <label class="field-row">
                    <span>前端端口</span>
                    <input v-model.number="settingsForm.ports.frontend" type="number" min="1" max="65535" />
                  </label>
                </section>

                <div v-if="settingsMessage" class="settings-message">{{ settingsMessage }}</div>
                <div v-if="settingsPath" class="editor-footer">
                  <span class="file-path">{{ settingsPath }}</span>
                </div>
              </template>
            </div>
          </div>

          <div v-else-if="!selectedFile" class="editor-placeholder">
            <p>👈 选择一个文件开始编辑</p>
          </div>
          <div v-else class="editor-content">
            <div class="editor-header">
              <h3>{{ selectedFile.filename }}</h3>
              <div class="editor-actions">
                <button @click="saveFile" :disabled="saving || !hasChanges">
                  {{ saving ? '保存中...' : '💾 保存' }}
                </button>
              </div>
            </div>
            
            <div v-if="fileError" class="validation-error">
              ⚠️ YAML 格式错误: {{ fileError }}
            </div>
            
            <textarea
              :key="selectedFile.filename"
              v-model="fileContent"
              class="code-editor"
              spellcheck="false"
              @input="onContentChange"
            ></textarea>
            
            <div class="editor-footer">
              <span class="file-path">{{ selectedFile.path }}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script setup>
import { ref, computed, onMounted } from 'vue'

// 后端基地址：开发态走 dev.sh 注入的 VITE_API_BASE；
// 打包态由 backend 直接当静态服务器返回页面，同源访问用相对路径即可
const API_BASE = import.meta.env.VITE_API_BASE || ''

const showManager = ref(false)
const activeMode = ref('form')
const loading = ref(false)
const error = ref('')
const files = ref([])
const selectedFile = ref(null)
const fileContent = ref('')
const originalContent = ref('')
const saving = ref(false)
const fileError = ref('')
const settingsLoading = ref(false)
const settingsSaving = ref(false)
const settingsError = ref('')
const settingsMessage = ref('')
const settingsPath = ref('')
const settingsForm = ref({
  [% if enable_sudo %]
  sudo_password: '',
  [% endif %]
  ports: {
    backend: 8000,
    frontend: 5173
  }
})

const hasChanges = computed(() => fileContent.value !== originalContent.value)

const open = () => {
  showManager.value = true
  activeMode.value = 'form'
  loadSettings()
  loadFileList()
}

const close = () => {
  if (hasChanges.value) {
    if (!confirm('有未保存的更改,确定要关闭吗?')) {
      return
    }
  }
  showManager.value = false
  selectedFile.value = null
  fileContent.value = ''
  originalContent.value = ''
}

const closeIfOutside = (e) => {
  if (e.target.classList.contains('file-overlay')) {
    close()
  }
}


const loadSettings = async () => {
  settingsLoading.value = true
  settingsError.value = ''
  settingsMessage.value = ''

  try {
    const response = await fetch(`${API_BASE}/api/settings`)
    const data = await response.json()
    if (!response.ok) throw new Error(data.detail || '读取应用配置失败')

    settingsPath.value = data.config_path || ''
    settingsForm.value = {
      [% if enable_sudo %]
      sudo_password: '',
      [% endif %]
      ports: {
        backend: data.ports?.backend || 8000,
        frontend: data.ports?.frontend || 5173
      }
    }
  } catch (e) {
    settingsError.value = e.message
    console.error('读取应用配置失败:', e)
  } finally {
    settingsLoading.value = false
  }
}

const saveSettings = async () => {
  settingsSaving.value = true
  settingsError.value = ''
  settingsMessage.value = ''

  try {
    const response = await fetch(`${API_BASE}/api/settings`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(settingsForm.value)
    })
    const data = await response.json()
    if (!response.ok) throw new Error(data.detail || '保存应用配置失败')

    settingsMessage.value = '配置已保存。可热重载配置已立即生效；端口变更需重启 dev.sh 或 Electron。'
    await loadFileList()
    await loadSettings()
  } catch (e) {
    settingsError.value = e.message
    console.error('保存应用配置失败:', e)
  } finally {
    settingsSaving.value = false
  }
}

const loadFileList = async () => {
  loading.value = true
  error.value = ''
  
  try {
    const response = await fetch(`${API_BASE}/api/files/list`)
    if (!response.ok) throw new Error('获取文件列表失败')
    
    const data = await response.json()
    files.value = data.files || []
  } catch (e) {
    error.value = e.message
    console.error('加载文件列表失败:', e)
  } finally {
    loading.value = false
  }
}

const loadFile = async (filename) => {
  try {
    const response = await fetch(`${API_BASE}/api/files/read/${filename}`)
    if (!response.ok) throw new Error('读取文件失败')
    
    const data = await response.json()
    selectedFile.value = data
    fileContent.value = data.content
    originalContent.value = data.content
    fileError.value = data.is_valid ? '' : data.error
  } catch (e) {
    alert(`加载文件失败: ${e.message}`)
    console.error('加载文件失败:', e)
  }
}

const onContentChange = () => {
  fileError.value = ''
}

const saveFile = async () => {
  if (!selectedFile.value || !hasChanges.value) return
  
  saving.value = true
  
  try {
    console.log('Saving file:', {
      filename: selectedFile.value.filename,
      contentLength: fileContent.value.length
    })
    
    const response = await fetch(`${API_BASE}/api/files/write`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        filename: selectedFile.value.filename,
        content: fileContent.value
      })
    })
    
    console.log('Response status:', response.status)
    
    const data = await response.json()
    console.log('Response data:', data)
    
    if (!response.ok) {
      throw new Error(data.detail || '保存失败')
    }
    
    // 重新拉一次 read 接口刷新 selectedFile / fileContent / originalContent，
    // 与磁盘对齐——之前是"前端自己 originalContent = fileContent"假定一致，
    // 但 path_manager.reload_config 后磁盘内容可能被规整化（YAML round-trip），
    // 不重读会让"再次点同一文件"出现微妙的状态分裂
    const savedFilename = selectedFile.value.filename
    await loadFileList()
    await loadFile(savedFilename)
    alert('保存成功!')
  } catch (e) {
    console.error('Save error:', e)
    alert(`保存失败: ${e.message}`)
  } finally {
    saving.value = false
  }
}

const formatSize = (bytes) => {
  if (bytes < 1024) return `${bytes} B`
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`
}

const formatTime = (timestamp) => {
  const date = new Date(timestamp * 1000)
  return date.toLocaleString('zh-CN')
}

defineExpose({ open })
</script>

