<script setup>
import { ref } from 'vue'
[% if enable_update %]
import UpdatePanel from './version/UpdatePanel.vue'
import CommitHistoryPanel from './version/CommitHistoryPanel.vue'
[% endif %]

const version = ref('v' + (__APP_VERSION__ || '0.0.0'))
const commits = ref(__GIT_COMMITS__ || [])
const showModal = ref(false)
[% if enable_update %]
const updatePanelRef = ref(null)

// 弹窗内检查更新：发现新版本时先关掉版本弹窗再显示更新弹窗，
// 避免更新弹窗被版本弹窗挡住；无更新则留在提交记录页
async function checkUpdateFromModal() {
  const opened = await updatePanelRef?.handleCheckUpdate()
  if (opened) showModal.value = false
}
[% endif %]
</script>

<template>
  <span
    class="version-badge"
[% if enable_update %]
    :title="updatePanelRef?.hasUpdate ? '发现新版本，点击查看' : '点击查看更新与提交记录'"
[% else %]
    title="点击查看提交记录"
[% endif %]
    @click="showModal = true"
  >
    <span class="version-text">{{ version }}</span>
[% if enable_update %]
    <span v-if="updatePanelRef?.loading" class="loading-dot">...</span>
    <span v-else-if="updatePanelRef?.hasUpdate" class="update-dot"></span>
[% endif %]
  </span>

[% if enable_update %]
  <!-- 更新检查逻辑（不可见，仅承载更新弹窗与状态） -->
  <UpdatePanel ref="updatePanelRef" />
[% endif %]

  <Teleport to="body">
    <div v-if="showModal" class="version-modal" @click="showModal = false">
      <div class="version-modal-content" @click.stop>
        <div class="version-modal-header">
          <div class="header-left">
            <h3>版本 <span class="version-num">{{ version }}</span></h3>
[% if enable_update %]
            <button
              class="check-btn"
              :disabled="updatePanelRef?.loading"
              :title="updatePanelRef?.hasUpdate ? `发现新版本 v${updatePanelRef?.latestVersion}` : '检查更新'"
              @click="checkUpdateFromModal"
            >
              {{ updatePanelRef?.loading ? '正在检查...' : '🔄 检查更新' }}
            </button>
[% endif %]
          </div>
          <button @click="showModal = false" class="close-btn">✕</button>
        </div>

        <div class="version-modal-body">
          <CommitHistoryPanel :commits="commits" />
        </div>
      </div>
    </div>
  </Teleport>
</template>

