<script setup>
import { computed, onMounted, ref } from 'vue'
import TerminalView from './TerminalView.vue'
import {
  sessions,
  activeId,
  createSession,
  closeSession,
  reconnectSession,
} from '../composables/useTerminalSessions'

const viewRefs = ref({})

// 本机页面默认直连本地终端；远端设备只能用 SSH 模式（用户名/IP/密码）连目标机器
const isLocal = ref(true)
const showSshForm = ref(false)
const sshHost = ref('')
const sshUsername = ref('')
const sshPassword = ref('')

const activeSession = computed(() => sessions.value.find((s) => s.id === activeId.value))

const statusText = computed(() => {
  const s = activeSession.value
  if (!s) return ''
  return { connecting: '连接中...', connected: '已连接', closed: '已断开', error: '连接失败' }[s.status] || '未连接'
})

function select(id) {
  activeId.value = id
}

function connectSsh() {
  if (!sshHost.value.trim() || !sshUsername.value.trim()) return
  createSession('ssh', {
    host: sshHost.value.trim(),
    username: sshUsername.value.trim(),
    password: sshPassword.value,
  })
  sshPassword.value = ''
  showSshForm.value = false
}

onMounted(async () => {
  try {
    const r = await fetch(`${import.meta.env.VITE_API_BASE || ''}/api/terminal/mode`)
    const d = r.ok ? await r.json() : {}
    isLocal.value = d.local !== false
  } catch {
    isLocal.value = true
  }
  // 远端设备不自动建本地终端（后端也会 4403 拒绝），直接显示 SSH 表单
  if (!isLocal.value) {
    showSshForm.value = true
    return
  }
  if (sessions.value.length === 0) {
    createSession()
  }
})
</script>

<template>
  <div class="terminal-page">
    <div class="terminal-toolbar">
      <div class="tab-strip">
        <button
          v-for="s in sessions"
          :key="s.id"
          class="term-tab"
          :class="{ active: s.id === activeId }"
          @click="select(s.id)"
        >
          <span class="dot" :class="s.status"></span>
          <span class="tab-title">{{ s.title }}</span>
          <span class="tab-close" role="button" @click.stop="closeSession(s.id)">×</span>
        </button>
        <button v-if="isLocal" class="term-new" title="新建本地终端" @click="createSession()">＋</button>
        <button class="term-new" title="SSH 连接其他设备" @click="showSshForm = !showSshForm">SSH</button>
      </div>

      <div class="toolbar-right">
        <span class="status-indicator" :class="activeSession?.status">{{ statusText }}</span>
        <button
          v-if="activeSession && activeSession.status !== 'connected'"
          class="tool-btn connect-btn"
          @click="reconnectSession(activeSession.id)"
        >
          重连
        </button>
      </div>
    </div>

    <!-- SSH 连接表单：任何设备可用，输入目标机器的 用户名/IP/密码 -->
    <div v-if="showSshForm" class="ssh-form">
      <input v-model="sshUsername" class="ssh-input" placeholder="用户名" @keyup.enter="connectSsh" />
      <input v-model="sshHost" class="ssh-input" placeholder="IP / 主机名" @keyup.enter="connectSsh" />
      <input v-model="sshPassword" class="ssh-input" type="password" placeholder="密码" @keyup.enter="connectSsh" />
      <button class="tool-btn connect-btn" :disabled="!sshHost.trim() || !sshUsername.trim()" @click="connectSsh">
        连接
      </button>
    </div>

    <div class="terminal-stack">
      <div v-if="sessions.length === 0" class="empty-state">
        没有终端，点击 ＋ 新建
      </div>
      <!-- 所有会话常驻挂载，仅用 v-show 切换显隐：
           用 v-if 会卸载组件并中断 pty 会话（这正是「切页终端被关闭」的原因） -->
      <div
        v-for="s in sessions"
        v-show="s.id === activeId"
        :key="s.id"
        class="terminal-slot"
      >
        <TerminalView :ref="(el) => (viewRefs[s.id] = el)" :session="s" :visible="s.id === activeId" />
      </div>
    </div>
  </div>
</template>

