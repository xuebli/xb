/**
 * 更新检查 composable - 版本检查、安装包下载、安装触发
 */

import { ref, onMounted, onUnmounted } from 'vue'

// 后端基地址：开发态走 Vite 代理 / 打包态为空字符串走同源相对路径
const API_BASE = import.meta.env.VITE_API_BASE || ''

// 检查间隔（毫秒）：1小时
const CHECK_INTERVAL = 60 * 60 * 1000
// 下载进度轮询间隔（毫秒）
const PROGRESS_INTERVAL = 500

export function useUpdate() {
  // 构建期注入的版本号，后端拿到结果后以后端为准（两者同源于 electron/package.json）
  const currentVersion = ref(__APP_VERSION__ || '0.0.0')
  const hasUpdate = ref(false)
  const latestVersion = ref('')
  const releaseDate = ref('')
  const releaseNotes = ref('')
  const hasConfigChanges = ref(false)
  const configSummary = ref('')
  const configFiles = ref([])
  const downloadUrl = ref('')
  const fileSize = ref(0)
  const fileHash = ref('')
  const filename = ref('')
  const source = ref('none')
  const canDownload = ref(false)
  // 后端是否为打包安装版；开发态（源码运行）不支持应用内更新
  const packaged = ref(true)
  const loading = ref(false)
  const error = ref('')
  const lastCheckTime = ref(null)

  // 下载状态：status 为 idle | downloading | verifying | done | error
  const downloadState = ref({
    status: 'idle',
    progress: 0,
    downloaded: 0,
    total: 0,
    error: '',
  })
  // 预计剩余秒数（按下载区间均速估算，null = 无法估算）
  const downloadEtaSeconds = ref(null)
  let progressMark = null // { at, done }
  const installing = ref(false)

  let checkTimer = null
  let progressTimer = null
  let progressController = null
  let progressGeneration = 0
  let disposed = false

  /**
   * 比较版本号
   * @returns 1(v1>v2), -1(v1<v2), 0(相等)
   */
  function compareVersion(v1, v2) {
    const parts1 = String(v1 || '0').split('.').map((x) => parseInt(x, 10) || 0)
    const parts2 = String(v2 || '0').split('.').map((x) => parseInt(x, 10) || 0)

    for (let i = 0; i < Math.max(parts1.length, parts2.length); i++) {
      const a = parts1[i] || 0
      const b = parts2[i] || 0
      if (a > b) return 1
      if (a < b) return -1
    }
    return 0
  }

  /**
   * 格式化文件大小
   */
  function formatFileSize(bytes) {
    if (!bytes) return '0 B'
    const k = 1024
    const sizes = ['B', 'KB', 'MB', 'GB']
    const i = Math.floor(Math.log(bytes) / Math.log(k))
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i]
  }

  /**
   * 检查更新
   * @param {boolean} force 跳过后端的远程信息缓存
   */
  async function checkUpdate(force = false) {
    if (loading.value) return null
    loading.value = true
    error.value = ''

    try {
      const response = await fetch(`${API_BASE}/api/update/check${force ? '?force=true' : ''}`)
      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`)
      }

      const data = await response.json()

      hasUpdate.value = data.has_update
      currentVersion.value = data.current_version || currentVersion.value
      latestVersion.value = data.latest_version
      releaseDate.value = data.release_date
      releaseNotes.value = data.release_notes
      hasConfigChanges.value = data.has_config_changes
      configSummary.value = data.config_summary
      configFiles.value = data.config_files || []
      downloadUrl.value = data.download_url
      fileSize.value = data.file_size
      fileHash.value = data.file_hash
      filename.value = data.filename
      source.value = data.source || 'none'
      canDownload.value = !!data.can_download
      packaged.value = !!data.packaged
      lastCheckTime.value = new Date()

      return data
    } catch (e) {
      error.value = e.message
      console.error('检查更新失败:', e)
      return null
    } finally {
      loading.value = false
    }
  }

  /**
   * 刷新一次下载进度
   */
  async function refreshProgress(generation = progressGeneration) {
    if (disposed || generation !== progressGeneration) return
    const controller = new AbortController()
    progressController = controller
    try {
      const response = await fetch(`${API_BASE}/api/update/download/progress`, {
        signal: controller.signal,
      })
      if (!response.ok) throw new Error(`HTTP ${response.status}`)
      const state = await response.json()
      // 新下载或停止轮询后，旧响应不能覆盖新的下载状态。
      if (disposed || generation !== progressGeneration) return
      downloadState.value = state

      if (state.status === 'downloading' && state.total > 0) {
        // 记录首个采样点，用区间均速估算剩余时间（瞬时速度抖动大）
        const now = Date.now()
        if (!progressMark) {
          progressMark = { at: now, done: state.downloaded }
          downloadEtaSeconds.value = null
        } else if (state.downloaded > progressMark.done) {
          const speed = (state.downloaded - progressMark.done) / ((now - progressMark.at) / 1000)
          if (speed > 0) {
            downloadEtaSeconds.value = Math.round((state.total - state.downloaded) / speed)
          }
        }
      } else {
        downloadEtaSeconds.value = null
        progressMark = null
      }

      if (['done', 'error', 'idle'].includes(state.status)) {
        stopProgressPolling()
        return
      }
    } catch (e) {
      if (e.name === 'AbortError') return
      console.error('查询下载进度失败:', e)
    } finally {
      if (progressController === controller) progressController = null
    }
    // 串行轮询；可恢复的网络/HTTP 错误在下一轮重试。
    if (!disposed && generation === progressGeneration) {
      progressTimer = setTimeout(() => refreshProgress(generation), PROGRESS_INTERVAL)
    }
  }

  function startProgressPolling() {
    stopProgressPolling()
    void refreshProgress(progressGeneration)
  }

  function stopProgressPolling() {
    progressGeneration += 1
    if (progressTimer) {
      clearTimeout(progressTimer)
      progressTimer = null
    }
    progressController?.abort()
    progressController = null
  }

  /**
   * 开始下载安装包
   */
  async function startDownload() {
    // 先作废旧下载的轮询，避免其迟到响应覆盖新会话。
    stopProgressPolling()
    progressMark = null
    error.value = ''
    try {
      const response = await fetch(`${API_BASE}/api/update/download`, { method: 'POST' })
      const data = await response.json()
      if (!response.ok) {
        throw new Error(data.detail || `HTTP ${response.status}`)
      }
      downloadState.value = data
      if (!disposed && ['downloading', 'verifying'].includes(data.status)) {
        startProgressPolling()
      }
      return data
    } catch (e) {
      error.value = e.message
      downloadState.value = { ...downloadState.value, status: 'error', error: e.message }
      return null
    }
  }

  /**
   * 执行安装：后端备份配置、应用配置变更并拉起安装程序，随后需要关闭应用
   * @param {boolean} applyConfig 是否同时应用配置变更
   */
  async function installUpdate(applyConfig = true) {
    installing.value = true
    error.value = ''
    try {
      const response = await fetch(`${API_BASE}/api/update/install`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ apply_config: applyConfig }),
      })
      const data = await response.json()
      if (!response.ok) {
        throw new Error(data.detail || `HTTP ${response.status}`)
      }
      return data
    } catch (e) {
      error.value = e.message
      return null
    } finally {
      installing.value = false
    }
  }

  /**
   * 启动定时检查
   */
  function startAutoCheck() {
    stopAutoCheck()
    if (disposed) return
    checkTimer = setInterval(() => {
      checkUpdate()
    }, CHECK_INTERVAL)
  }

  /**
   * 停止定时检查
   */
  function stopAutoCheck() {
    if (checkTimer) {
      clearInterval(checkTimer)
      checkTimer = null
    }
  }

  /**
   * 初始化：立即检查一次，然后启动定时检查
   */
  async function init() {
    await checkUpdate()
    startAutoCheck()
  }

  // 组件挂载时自动初始化
  onMounted(() => {
    init()
  })

  // 组件卸载时清理
  onUnmounted(() => {
    disposed = true
    stopAutoCheck()
    stopProgressPolling()
  })

  return {
    // 状态
    currentVersion,
    hasUpdate,
    latestVersion,
    releaseDate,
    releaseNotes,
    hasConfigChanges,
    configSummary,
    configFiles,
    downloadUrl,
    fileSize,
    fileHash,
    filename,
    source,
    canDownload,
    packaged,
    loading,
    error,
    lastCheckTime,
    downloadState,
    downloadEtaSeconds,
    installing,

    // 方法
    compareVersion,
    formatFileSize,
    checkUpdate,
    startDownload,
    refreshProgress,
    installUpdate,
    startAutoCheck,
    stopAutoCheck,
    init,
  }
}
