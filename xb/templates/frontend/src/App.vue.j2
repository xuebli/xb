<script setup>
import { ref } from 'vue'
import DashboardHome from './components/DashboardHome.vue'
[% if enable_terminal %]
import TerminalPanel from './components/TerminalPanel.vue'
[% endif %]
import RefreshButton from './components/RefreshButton.vue'
import ThemeToggle from './components/ThemeToggle.vue'
import GitVersionBadge from './components/GitVersionBadge.vue'
[% if enable_sudo %]
import ConfigSetup from './components/ConfigSetup.vue'
[% endif %]
import FileManager from './components/FileManager.vue'

const currentPage = ref('home')
[% if icon_path %]
const showIconFallback = ref(false)
[% endif %]

const navItems = [
  { id: 'home', label: '首页', icon: '🏠' },
[% if enable_terminal %]
  { id: 'terminal', label: '终端', icon: '💻' },
[% endif %]
  { id: 'settings', label: '配置', icon: '⚒' },
]

const handleRefresh = () => {
  window.location.reload()
}

const openSettings = () => {
  currentPage.value = 'settings'
}
</script>

<template>
  <div class="app-shell">
    <div class="ambient-bg" aria-hidden="true">
      <span class="node node-a"></span>
      <span class="node node-b"></span>
      <span class="node node-c"></span>
      <span class="node node-d"></span>
      <span class="node node-e"></span>
      <span class="node node-f"></span>
      <span class="link link-a"></span>
      <span class="link link-b"></span>
      <span class="link link-c"></span>
      <span class="link link-d"></span>
      <span class="link link-e"></span>
    </div>
    [% if enable_sudo %]
    <ConfigSetup />
    [% endif %]

    <header class="topbar">
      <div class="brand-block">
[% if icon_path %]
        <div class="brand-mark" :class="{ 'has-icon': !showIconFallback }">
          <img v-if="!showIconFallback" src="/app-icon.png" alt="[[ package_name_capitalized]]" @error="showIconFallback = true" />
          <span v-else>[[ package_name_capitalized | first ]]</span>
        </div>
[% else %]
        <div class="brand-mark">
          <span>[[ package_name_capitalized | first ]]</span>
        </div>
[% endif %]
        <div>
          <h1>[[ package_name_capitalized]] <GitVersionBadge /></h1>
          <p>AI Native · FastAPI · Electron</p>
        </div>
      </div>

      <div class="toolbar">
        <ThemeToggle />
        <RefreshButton @refresh="handleRefresh" />
        <button class="icon-button" @click="openSettings" title="配置中心" aria-label="配置中心">
          <span>⚒</span>
        </button>
      </div>
    </header>

    <main class="workspace">
      <nav class="side-nav">
        <button
          v-for="item in navItems"
          :key="item.id"
          class="nav-item"
          :class="{ active: currentPage === item.id }"
          @click="currentPage = item.id"
          :title="item.label"
        >
          <span class="nav-icon">{{ item.icon }}</span>
          <span class="nav-label">{{ item.label }}</span>
        </button>
      </nav>
      <div
        class="page-content"
        :class="currentPage === 'home' ? 'page-content--centered' : 'page-content--stretch'"
      >
        <DashboardHome v-if="currentPage === 'home'" @open-settings="openSettings" />
        <FileManager v-else-if="currentPage === 'settings'" />
[% if enable_terminal %]
        <TerminalPanel v-show="currentPage === 'terminal'" />
[% endif %]
      </div>
    </main>
  </div>
</template>
