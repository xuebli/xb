<script setup>
import { ref[% if enable_feishu_auth %], onMounted[% endif %] } from 'vue'
[% if enable_feishu_auth %]
import { useAuth } from './composables/useAuth'
[% endif %]
import DashboardHome from './components/DashboardHome.vue'
[% if enable_terminal %]
import TerminalPanel from './components/TerminalPanel.vue'
[% endif %]
import RefreshButton from './components/RefreshButton.vue'
import ThemeToggle from './components/ThemeToggle.vue'
import GitVersionBadge from './components/GitVersionBadge.vue'
import SettingsView from './components/SettingsView.vue'
[% if enable_logs %]
import LogViewer from './components/LogViewer.vue'
[% endif %]
[% if enable_csv_test %]
import FactoryTestView from './views/FactoryTestView.vue'
[% endif %]

const currentPage = ref('home')
[% if icon_path %]
const showIconFallback = ref(false)
[% endif %]
[% if enable_feishu_auth %]

const { user: authUser, loaded: authLoaded, required: authRequired, kicked, load: loadAuth, login, logout, startPoll } = useAuth()
const apiBase = import.meta.env.VITE_API_BASE || ''
onMounted(() => { loadAuth().then(startPoll) })
[% endif %]

const navItems = [
  { id: 'home', label: '首页', icon: '🏠' },
[% if enable_csv_test %]
  { id: 'csvTest', label: '产测', icon: '🧪' },
[% endif %]
[% if enable_logs %]
  { id: 'logs', label: '日志', icon: '📜' },
[% endif %]
[% if enable_terminal %]
  { id: 'terminal', label: '终端', icon: '💻' },
[% endif %]
  { id: 'settingsView', label: '设置', icon: '⚙' },
]

const handleRefresh = () => {
  window.location.reload()
}

const openSettings = () => {
  currentPage.value = 'settingsView'
}
</script>

<template>
[% if enable_feishu_auth %]
  <!-- 强制登录墙：auth.required 且未登录时只渲染登录卡片（应用完全不挂载，避免 401 噪音） -->
  <div v-if="authRequired && authLoaded && !authUser" class="login-wall">
    <div class="login-card">
      <div class="brand-mark"><img src="/app-icon.png" alt="" onerror="this.style.display='none'" /></div>
      <h2>{{ kicked ? '⚠ 账号已在别处登录' : '[[ display_name ]]' }}</h2>
      <p>{{ kicked ? '本机会话已被新设备挤下线，如非本人操作请及时反馈；可重新登录（对方将被挤下线）' : '多人协作模式：请使用飞书扫码登录后继续' }}</p>
      <button class="login-btn big" @click="login">{{ kicked ? '重新登录' : '飞书登录' }}</button>
      <p class="tip">同一账号同时只能一台电脑在线，新设备登录会使旧设备自动登出</p>
    </div>
  </div>
  <div v-else class="app-shell">
[% else %]
  <div class="app-shell">
[% endif %]
    <div class="ambient-bg" aria-hidden="true">
      <span class="node node-a"></span>
      <span class="node node-b"></span>
      <span class="node node-c"></span>
      <span class="node node-d"></span>
      <span class="node node-e"></span>
      <span class="node node-f"></span>
      <span class="link link-a"></span>
      <span class="link link-b"></span>
      <span class="link link-c"></span>
      <span class="link link-d"></span>
      <span class="link link-e"></span>
    </div>

    <header class="topbar">
      <div class="brand-block">
[% if icon_path %]
        <div class="brand-mark" :class="{ 'has-icon': !showIconFallback }">
          <img v-if="!showIconFallback" src="/app-icon.png" alt="[[ display_name ]]" @error="showIconFallback = true" />
          <span v-else>[[ display_name | first ]]</span>
        </div>
[% else %]
        <div class="brand-mark">
          <span>[[ display_name | first ]]</span>
        </div>
[% endif %]
        <div>
          <h1>[[ display_name ]] <GitVersionBadge /></h1>
          <p>AI Native · FastAPI · Electron</p>
        </div>
      </div>

      <div class="toolbar">
        <ThemeToggle />
        <RefreshButton @refresh="handleRefresh" />
[% if enable_feishu_auth %]
        <!-- 飞书登录状态（未登录显示登录按钮，已登录显示头像/姓名，点击登出） -->
        <button v-if="authLoaded && !authUser" class="login-btn" @click="login">飞书登录</button>
        <div v-else-if="authUser" class="user-chip" :title="`${authUser.name}（点击登出）`" @click="logout">
          <img v-if="authUser.has_avatar" :src="`${apiBase}/api/auth/avatar`" class="avatar" alt="" />
          <span class="uname">{{ authUser.name || authUser.en_name }}</span>
        </div>
[% endif %]
      </div>
    </header>

    <main class="workspace">
      <nav class="side-nav">
        <button
          v-for="item in navItems"
          :key="item.id"
          class="nav-item"
          :class="{ active: currentPage === item.id }"
          @click="currentPage = item.id"
          :title="item.label"
        >
          <span class="nav-icon">{{ item.icon }}</span>
          <span class="nav-label">{{ item.label }}</span>
        </button>
      </nav>
      <div
        class="page-content"
        :class="currentPage === 'home' ? 'page-content--centered' : 'page-content--stretch'"
      >
        <DashboardHome v-if="currentPage === 'home'" @open-settings="openSettings" />
[% if enable_csv_test %]
        <FactoryTestView v-else-if="currentPage === 'csvTest'" />
[% endif %]
[% if enable_logs %]
        <LogViewer v-else-if="currentPage === 'logs'" />
[% endif %]
        <SettingsView v-else-if="currentPage === 'settingsView'" />
[% if enable_terminal %]
        <TerminalPanel v-show="currentPage === 'terminal'" />
[% endif %]
      </div>
    </main>
  </div>
</template>
