<script setup>
import { ref[% if enable_feishu_auth %], onMounted[% endif %] } from 'vue'
[% if enable_feishu_auth %]
import { useAuth } from './composables/useAuth'
[% endif %]
[% if not enable_csv_test %]
import DashboardHome from './components/DashboardHome.vue'
[% endif %]
[% if enable_terminal %]
import TerminalPanel from './components/TerminalPanel.vue'
[% endif %]
import RefreshButton from './components/RefreshButton.vue'
import ThemeToggle from './components/ThemeToggle.vue'
import GitVersionBadge from './components/GitVersionBadge.vue'
import SettingsView from './components/SettingsView.vue'
[% if enable_logs %]
import LogViewer from './components/LogViewer.vue'
[% endif %]
[% if enable_csv_test %]
import FactoryTestView from './views/FactoryTestView.vue'
import DashboardView from './views/DashboardView.vue'
[% endif %]

// csv-test 项目没有首页：看板即首页
const currentPage = ref([% if enable_csv_test %]'dashboard'[% else %]'home'[% endif %])
const showIconFallback = ref(false)
[% if enable_feishu_auth %]

const { user: authUser, loaded: authLoaded, required: authRequired, kicked, load: loadAuth, login, logout, startPoll } = useAuth()
const apiBase = import.meta.env.VITE_API_BASE || ''
const showUserCard = ref(false)
const profile = ref({})   // 通讯录名片（职务/部门/邮箱等，权限未开通的字段为空不显示）
const toggleUserCard = async () => {
  showUserCard.value = !showUserCard.value
  if (showUserCard.value && !profile.value._loaded) {
    try {
      const r = await fetch(`${apiBase}/api/auth/profile`)
      if (r.ok) profile.value = { ...(await r.json()), _loaded: true }
    } catch { /* 名片加载失败只显示基础字段 */ }
  }
}
onMounted(() => { loadAuth().then(startPoll) })
[% endif %]

const navItems = [
[% if enable_csv_test %]
  // 产测项目：看板即首页（置顶），无独立首页
  { id: 'dashboard', label: '看板', icon: '📈' },
  { id: 'csvTest', label: '产测', icon: '🧪' },
[% else %]
  { id: 'home', label: '首页', icon: '🏠' },
[% endif %]
[% if enable_logs %]
  { id: 'logs', label: '日志', icon: '📜' },
[% endif %]
[% if enable_terminal %]
  { id: 'terminal', label: '终端', icon: '💻' },
[% endif %]
  { id: 'settingsView', label: '设置', icon: '⚙' },
]

const handleRefresh = () => {
  window.location.reload()
}

const openSettings = () => {
  currentPage.value = 'settingsView'
}
</script>

<template>
[% if enable_feishu_auth %]
  <!-- 强制登录墙：auth.required 且未登录时只渲染登录卡片（应用完全不挂载，避免 401 噪音） -->
  <div v-if="authRequired && authLoaded && !authUser" class="login-wall">
    <div class="login-card">
      <div class="brand-mark"><img src="/app-icon.png" alt="" onerror="this.style.display='none'" /></div>
      <h2>{{ kicked ? '⚠ 账号已在别处登录' : '[[ display_name ]]' }}</h2>
      <p>{{ kicked ? '本机会话已被新设备挤下线，如非本人操作请及时反馈；可重新登录（对方将被挤下线）' : '多人协作模式：请使用飞书扫码登录后继续' }}</p>
      <button class="login-btn big" @click="login">{{ kicked ? '重新登录' : '飞书登录' }}</button>
      <p class="tip">同一账号同时只能一台电脑在线，新设备登录会使旧设备自动登出</p>
    </div>
  </div>
  <div v-else class="app-shell">
[% else %]
  <div class="app-shell">
[% endif %]
    <div class="ambient-bg" aria-hidden="true">
      <span class="node node-a"></span>
      <span class="node node-b"></span>
      <span class="node node-c"></span>
      <span class="node node-d"></span>
      <span class="node node-e"></span>
      <span class="node node-f"></span>
      <span class="link link-a"></span>
      <span class="link link-b"></span>
      <span class="link link-c"></span>
      <span class="link link-d"></span>
      <span class="link link-e"></span>
    </div>

    <header class="topbar">
      <div class="brand-block">
        <div class="brand-mark" :class="{ 'has-icon': !showIconFallback }">
          <img v-if="!showIconFallback" src="/app-icon.png" alt="[[ display_name ]]" @error="showIconFallback = true" />
          <span v-else>[[ display_name | first ]]</span>
        </div>
        <div>
          <h1>[[ display_name ]] <GitVersionBadge /></h1>
          <p>AI Native · FastAPI · Electron</p>
        </div>
      </div>

      <div class="toolbar">
        <ThemeToggle />
        <RefreshButton @refresh="handleRefresh" />
[% if enable_feishu_auth %]
        <!-- 飞书登录状态（未登录显示登录按钮，已登录显示头像/姓名，点击弹出个人信息卡片） -->
        <button v-if="authLoaded && !authUser" class="login-btn" @click="login">飞书登录</button>
        <div v-else-if="authUser" class="user-menu">
          <div class="user-chip" :title="authUser.name" @click.stop="toggleUserCard">
            <img v-if="authUser.has_avatar" :src="`${apiBase}/api/auth/avatar`" class="avatar" alt="" />
            <span class="uname">{{ authUser.name || authUser.en_name }}</span>
          </div>
        </div>
        <!-- 名片卡片 Teleport 到 body：topbar 有 z-index:20 会形成层叠上下文，
             卡片在内部会被高 z-index 的页面元素（弹窗等）盖住，必须逃出来 -->
        <Teleport to="body">
          <div v-if="showUserCard" class="user-card-mask" @click="showUserCard = false"></div>
          <div v-if="showUserCard" class="user-card" @click.stop>
            <img v-if="authUser?.has_avatar" :src="`${apiBase}/api/auth/avatar`" class="avatar-big" alt="" />
            <div class="user-card-name">{{ authUser?.name || authUser?.en_name }}</div>
            <div v-if="authUser?.en_name && authUser?.en_name !== authUser?.name" class="user-card-sub">{{ authUser.en_name }}</div>
            <div class="user-card-rows">
              <div v-if="profile.department" class="user-card-row"><span>部门</span><b>{{ profile.department }}</b></div>
              <div v-if="profile.job_title" class="user-card-row"><span>职务</span><b>{{ profile.job_title }}</b></div>
              <div v-if="profile.leader" class="user-card-row"><span>直属上级</span><b>{{ profile.leader }}</b></div>
              <div v-if="profile.enterprise_email" class="user-card-row"><span>企业邮箱</span><b>{{ profile.enterprise_email }}</b></div>
              <div v-else-if="profile.email" class="user-card-row"><span>邮箱</span><b>{{ profile.email }}</b></div>
              <div v-if="profile.employee_no" class="user-card-row"><span>工号</span><b>{{ profile.employee_no }}</b></div>
              <div v-if="profile.city" class="user-card-row"><span>城市</span><b>{{ profile.city }}</b></div>
              <div class="user-card-row"><span>ID</span><b class="mono">{{ authUser?.open_id }}</b></div>
            </div>
            <button class="logout-btn" @click="showUserCard = false; logout()">退出登录</button>
          </div>
        </Teleport>
[% endif %]
      </div>
    </header>

    <main class="workspace">
      <nav class="side-nav">
        <button
          v-for="item in navItems"
          :key="item.id"
          class="nav-item"
          :class="{ active: currentPage === item.id }"
          @click="currentPage = item.id"
          :title="item.label"
        >
          <span class="nav-icon">{{ item.icon }}</span>
          <span class="nav-label">{{ item.label }}</span>
        </button>
      </nav>
      <div
        class="page-content"
        :class="currentPage === '[% if not enable_csv_test %]home[% endif %]' ? 'page-content--centered' : 'page-content--stretch'"
      >
[% if enable_csv_test %]
        <DashboardView v-if="currentPage === 'dashboard'" />
        <FactoryTestView v-else-if="currentPage === 'csvTest'" />
[% else %]
        <DashboardHome v-if="currentPage === 'home'" @open-settings="openSettings" />
[% endif %]
[% if enable_logs %]
        <LogViewer v-else-if="currentPage === 'logs'" />
[% endif %]
        <SettingsView v-else-if="currentPage === 'settingsView'" />
[% if enable_terminal %]
        <TerminalPanel v-show="currentPage === 'terminal'" />
[% endif %]
      </div>
    </main>
  </div>
</template>
