#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# 可直接执行：Linux/macOS 用 ./dev.py start，Windows 用 .\dev.py start（依赖 .py 文件关联）。
import os
import signal
import shutil
import subprocess
import sys
import time
from pathlib import Path

# 项目根目录以及运行时 PID、日志目录；两种平台统一使用同一布局。
ROOT = Path(__file__).resolve().parent
PID_DIR = ROOT / "datas" / "pids"
LOG_DIR = ROOT / "datas" / "logs"

# stdout 被重定向为管道/文件时，Windows 上默认按 GBK 编码，✓ 会抛 UnicodeEncodeError。
for _stream in (sys.stdout, sys.stderr):
    try:
        _stream.reconfigure(encoding="utf-8", errors="replace")
    except (AttributeError, ValueError):
        pass


def _ask_sudo_password() -> str:
    """终端询问本机 sudo 密码（仅本次使用，不落盘）。"""
    if sys.stdin is None or not sys.stdin.isatty():
        return ""
    from getpass import getpass

    return getpass("请输入本机 sudo 密码（仅本次使用，不会保存）: ").strip()


def chsrc_set_uv() -> None:
    """uv 换最优镜像源：chsrc set uv first（自动测速选最快）。

    - 未安装 chsrc 时自动安装（curl https://chsrc.run/posix | sudo bash）：
      sudo 密码在终端询问（仅本次使用，不落盘）；非交互终端跳过换源
    - chsrc 写用户级 uv 配置（~/.config/uv/uv.toml），对本机所有项目生效
    - 失败只告警，不阻塞启动（沿用当前源）
    """
    chsrc = "chsrc.exe" if sys.platform == "win32" else "chsrc"
    if not shutil.which(chsrc):
        if sys.platform == "win32":
            print("⚠️ 未检测到 chsrc（https://chsrc.run），跳过 uv 换源")
            return
        print("→ 未检测到 chsrc，自动安装（curl https://chsrc.run/posix | sudo bash）...")
        try:
            password = _ask_sudo_password()
            if not password:
                print("⚠️ 非交互终端无法询问密码，跳过 chsrc 安装（稍后在终端重跑 start）")
                return
            subprocess.run(
                ["sudo", "-S", "-p", "", "-v"],
                input=password + "\n",
                text=True,
                check=True,
                timeout=30,
            )
            subprocess.run(
                ["bash", "-c", "curl https://chsrc.run/posix | sudo bash"],
                check=True,
                timeout=180,
            )
        except Exception as e:
            print(f"⚠️ chsrc 安装失败，跳过 uv 换源: {e}")
            return
    try:
        print("→ 正在切换 uv 最优镜像源 (chsrc set uv first)...")
        result = subprocess.run(
            [chsrc, "set", "uv", "first"], capture_output=True, text=True, timeout=120
        )
        output = ((result.stdout or "") + (result.stderr or "")).strip()
        if output:
            print(output)
    except Exception as e:
        print(f"⚠️ chsrc 设置 uv 源失败，沿用当前源: {e}")


# ---------------------------------------------------------------- polkit
# 开发模式下没有 DEB postinst，特权入口需要手动部署一次；
# 打包态由安装脚本自动处理，这里只服务开发调试场景。

POLKIT_SRC = ROOT / "electron" / "resources" / "polkit"
POLKIT_HELPER_DST = Path("/usr/local/share") / "[[ package_name ]]" / "privileged-helper"
POLKIT_POLICY_DST = (
    Path("/usr/share/polkit-1/actions") / "com.[[ package_name ]].privileged.policy"
)
POLKIT_RULES_DST = (
    Path("/etc/polkit-1/rules.d") / "60-[[ package_name ]]-privileged.rules"
)


def _run_sudo_script(script: str) -> bool:
    """以 root 执行一段 shell（sudo -S 从 stdin 读密码），失败返回 False。"""
    password = _ask_sudo_password()
    try:
        if not password:
            print("⚠️ 未输入 sudo 密码，无法提权（仅交互终端可询问）")
            return False
        result = subprocess.run(
            ["sudo", "-S", "-p", "", "bash", "-c", script],
            input=password + "\n",
            text=True,
            capture_output=True,
            timeout=60,
        )
        if result.returncode != 0:
            print((result.stderr or result.stdout).strip() or "执行失败")
            return False
        return True
    except Exception as e:
        print(f"⚠️ 执行失败: {e}")
        return False


def polkit_install_script() -> str:
    """生成部署三件套的 root shell 脚本（文件拷贝而非符号链接——
    root 拥有的链接指向用户可写的项目文件等于提权后门）。"""
    return "\n".join(
        [
            "install -d -m755 /usr/share/polkit-1/actions /etc/polkit-1/rules.d",
            f"install -d -m755 '/usr/local/share/[[ package_name ]]'",
            f"install -m755 '{POLKIT_SRC}/privileged-helper.sh' '{POLKIT_HELPER_DST}'",
            f"install -m644 '{POLKIT_SRC}/privileged.policy' '{POLKIT_POLICY_DST}'",
            f"install -m644 '{POLKIT_SRC}/privileged.rules' '{POLKIT_RULES_DST}'",
        ]
    )


def polkit_manage(sub: str) -> None:
    """部署/卸载/查看 polkit 特权入口（开发调试用）。

    注意：部署的是文件拷贝而非符号链接——root 拥有的链接指向用户可写的
    项目文件等于提权后门。修改 helper 分支后需重新执行 install。
    """
    if os.name == "nt":
        print("Windows 无 polkit，无需部署")
        return
    if not POLKIT_SRC.is_dir():
        print(f"项目未生成 polkit 资源（未启用 --update）：{POLKIT_SRC} 不存在")
        raise SystemExit(1)

    if sub == "status":
        for label, path in (
            ("helper", POLKIT_HELPER_DST),
            ("policy", POLKIT_POLICY_DST),
            ("rules", POLKIT_RULES_DST),
        ):
            try:
                deployed = path.exists()
            except OSError:
                # /etc/polkit-1/rules.d 等目录普通用户不可入，不可读视为未部署
                deployed = False
            state = "✓ 已部署" if deployed else "✘ 未部署"
            print(f"{label:<8} {state}  {path}")
        return

    if sub == "install":
        if _run_sudo_script(polkit_install_script()):
            print("✓ polkit 特权入口已部署（管理员组成员免密生效）")
            print(f"  修改 helper 分支后请重新执行本命令同步（{POLKIT_HELPER_DST}）")
        else:
            raise SystemExit(1)
    elif sub == "remove":
        script = "\n".join(
            f"rm -f '{p}'" for p in (POLKIT_HELPER_DST, POLKIT_POLICY_DST, POLKIT_RULES_DST)
        )
        if _run_sudo_script(script):
            print("✓ polkit 特权入口已卸载")
        else:
            raise SystemExit(1)
    else:
        print("用法: python dev.py polkit install|remove|status")
        raise SystemExit(2)


def stop_service(name: str) -> None:
    """停止指定服务并删除 PID 文件。Windows 递归结束子进程。"""
    pid_file = PID_DIR / f"{name}.pid"
    if not pid_file.exists():
        print(f"{name} 未运行（未找到 PID 文件）")
        return
    try:
        pid = int(pid_file.read_text())
        if os.name == "nt":
            subprocess.run(["taskkill", "/PID", str(pid), "/T", "/F"], check=False,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            os.killpg(os.getpgid(pid), signal.SIGTERM)
        print(f"已停止 {name}（PID {pid}）")
    except (OSError, ValueError):
        pass
    pid_file.unlink(missing_ok=True)


def service_status(name: str) -> str:
    return "运行中" if process_alive(name) else "未运行"


def kill_port(port: int) -> None:
    """清理 PID 文件之外仍占用端口的进程，兼容 Windows/Linux。"""
    if os.name == "nt":
        result = subprocess.run(["netstat", "-ano"], capture_output=True, text=True, check=False)
        pids = {line.split()[-1] for line in result.stdout.splitlines()
                if f":{port}" in line and "LISTENING" in line}
        for pid in pids:
            subprocess.run(["taskkill", "/PID", pid, "/T", "/F"], check=False)
    elif shutil.which("lsof"):
        result = subprocess.run(["lsof", "-ti", f"TCP:{port}"], capture_output=True, text=True, check=False)
        for pid in result.stdout.split():
            try:
                os.kill(int(pid), signal.SIGTERM)
            except (OSError, ValueError):
                pass


def start_service(
    name: str,
    command: list[str],
    cwd: Path = ROOT,
    environment_updates: dict[str, str] | None = None,
) -> None:
    """启动服务，将标准输出和错误统一写入 datas/logs。"""
    stop_service(name)
    log_file = (LOG_DIR / f"{name}.log").open("a", encoding="utf-8", newline="")
    environment = os.environ.copy()
    if environment_updates:
        environment.update(environment_updates)
    # Windows 控制台默认使用 CP936；强制 Python 子进程以 UTF-8 输出，避免日志混合编码。
    environment["PYTHONIOENCODING"] = "utf-8"
    environment["PYTHONUTF8"] = "1"
    creationflags = 0
    if os.name == "nt":
        # 隐藏服务子进程控制台，避免启动后弹出空白的 python.exe 黑窗口。
        creationflags = subprocess.CREATE_NO_WINDOW | subprocess.CREATE_NEW_PROCESS_GROUP
    process = subprocess.Popen(
        command,
        cwd=cwd,
        stdin=subprocess.DEVNULL,
        stdout=log_file,
        stderr=subprocess.STDOUT,
        env=environment,
        start_new_session=os.name != "nt",
        creationflags=creationflags,
        close_fds=os.name != "nt",
    )
    (PID_DIR / f"{name}.pid").write_text(str(process.pid))


def install_git_hooks() -> None:
    """启动前安装 Git 钩子；非 Git 仓库或安装失败只提示，不阻断服务启动。"""
    script = ROOT / "version" / "scripts" / "install_hooks.py"
    if not script.exists():
        return
    environment = os.environ.copy()
    # 子脚本会输出中文；Windows 控制台默认 CP936，强制 UTF-8 避免乱码。
    environment["PYTHONIOENCODING"] = "utf-8"
    environment["PYTHONUTF8"] = "1"
    result = subprocess.run(
        [sys.executable, str(script)], cwd=ROOT, env=environment,
        capture_output=True, text=True, encoding="utf-8", errors="replace", check=False,
    )
    if result.returncode == 0:
        print("✓ Git hooks 已安装")
        return
    lines = [line for line in (result.stderr + result.stdout).splitlines() if line.strip()]
    print(f"! 跳过 Git hooks 安装：{lines[-1].strip() if lines else '未知原因'}")


def wait_for_port(port: int, timeout: float = 20.0) -> bool:
    """等待服务开始监听端口，避免前端早于后端启动。"""
    import socket
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        with socket.socket() as sock:
            if sock.connect_ex(("127.0.0.1", port)) == 0:
                return True
        time.sleep(0.5)
    return False


def port_is_free(port: int) -> bool:
    import socket
    with socket.socket() as sock:
        try:
            # 服务关闭后 TCP 连接可能短暂保留在 TIME_WAIT。复用地址后再 listen，
            # 可区分该回收状态与真正仍在监听的进程。
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            sock.bind(("127.0.0.1", port))
            sock.listen(1)
            return True
        except OSError:
            return False


def print_port_owner(port: int) -> None:
    """显示占用端口的 PID，帮助定位启动失败原因。"""
    if os.name == "nt":
        result = subprocess.run(["netstat", "-ano"], capture_output=True, text=True, check=False)
        owners = {line.split()[-1] for line in result.stdout.splitlines()
                  if f":{port}" in line and "LISTENING" in line}
    else:
        result = subprocess.run(["lsof", "-ti", f"TCP:{port}"], capture_output=True, text=True, check=False)
        owners = set(result.stdout.split())
    if owners:
        print(f"端口 {port} 已被占用，PID: {', '.join(sorted(owners))}")


def process_alive(name: str) -> bool:
    path = PID_DIR / f"{name}.pid"
    if not path.exists():
        return False
    try:
        pid = int(path.read_text())
        os.kill(pid, 0)
        return True
    except (OSError, ValueError):
        return False


def configured_port(name: str, default: int) -> int:
    """读取 global_config.yaml；配置缺失、格式错误或解释器没装 PyYAML 时使用默认端口。"""
    try:
        import yaml
        config = yaml.safe_load(
            (ROOT / "configs" / "global_config.yaml").read_text(encoding="utf-8")
        ) or {}
        return int(config.get("ports", {}).get(name, default))
    except (ImportError, OSError, TypeError, ValueError):
        return default


PID_DIR.mkdir(parents=True, exist_ok=True)
LOG_DIR.mkdir(parents=True, exist_ok=True)
# start/stop/restart/status/polkit 与原开发脚本保持一致。
action = sys.argv[1].lower() if len(sys.argv) > 1 else "start"
if action == "polkit":
    polkit_manage(sys.argv[2].lower() if len(sys.argv) > 2 else "status")
    raise SystemExit(0)
if action not in {"start", "stop", "restart", "status"}:
    usage = ".\\dev.py" if os.name == "nt" else "./dev.py"
    print(f"用法: {usage} {{start|stop|restart|status}} 或 {usage} polkit {{install|remove|status}}")
    raise SystemExit(2)
backend_port = configured_port("backend", 8000)
frontend_port = configured_port("frontend", 5173)
python = ROOT / (".venv/Scripts/python.exe" if os.name == "nt" else ".venv/bin/python")
service_python = (
    python.with_name("pythonw.exe")
    if os.name == "nt" and python.with_name("pythonw.exe").exists()
    else python
)
npm = "npm.cmd" if os.name == "nt" else "npm"

if action in {"stop", "restart"}:
    # 重启前先停止旧的前后端，避免端口和旧进程残留。
    stop_service("backend")
    stop_service("frontend")
    kill_port(backend_port)
    kill_port(frontend_port)
    if action == "stop":
        print("✓ 服务已停止")
if action in {"start", "restart"}:
    # 启动服务前先安装 Git 钩子，保证提交时版本检查始终生效。
    install_git_hooks()
    # 后端必须先启动并通过端口检查，前端才继续启动。
    if not port_is_free(backend_port):
        print_port_owner(backend_port)
        raise SystemExit(f"后端端口 {backend_port} 已被占用")
    if not python.exists():
        # 首次同步依赖前先切到最快的 uv 镜像源，避免默认源拖慢/拖挂
        chsrc_set_uv()
        print("→ 正在同步 Python 依赖，首次启动可能需要几分钟...")
        try:
            subprocess.run(
                ["uv", "sync", "--extra", "dev"],
                cwd=ROOT,
                check=True,
                timeout=600,
            )
        except subprocess.TimeoutExpired:
            raise SystemExit(
                "Python 依赖同步超时，请检查网络或 uv 镜像后重新执行 python dev.py start"
            )
    start_service("backend", [str(service_python), "backend/main.py"])
    print(f"✓ 后端已启动（PID 文件: {PID_DIR / 'backend.pid'}，端口: {backend_port}）")
[% if enable_update %]
    if os.name != "nt" and POLKIT_SRC.is_dir():
        # 开发模式没有 DEB postinst，start 时自动部署特权入口；
        # 项目内 helper 比 部署副本新（改过分支）或尚未部署时自动同步。
        # 密码在终端询问（仅本次使用，不落盘）；非交互终端跳过不阻塞。
        try:
            polkit_stale = (
                not POLKIT_HELPER_DST.exists()
                or (POLKIT_SRC / "privileged-helper.sh").stat().st_mtime
                > POLKIT_HELPER_DST.stat().st_mtime
            )
        except OSError:
            polkit_stale = True
        if polkit_stale:
            if _run_sudo_script(polkit_install_script()):
                print("✓ polkit 特权入口已自动部署/同步（管理员组免密生效）")
            else:
                print("ℹ polkit 特权入口未部署，应用内更新/特权功能不可用；"
                      "可稍后执行 python dev.py polkit install 重试")
[% endif %]
    if not wait_for_port(backend_port):
        stop_service("backend")
        raise SystemExit("后端启动失败，请查看 datas/logs/backend.log")
    frontend = ROOT / "frontend"
    if (frontend / "package.json").exists():
        if not (frontend / "node_modules").exists():
            print("→ 正在安装前端依赖，首次启动可能需要几分钟...")
            try:
                subprocess.run(
                    [npm, "install", "--no-audit", "--no-fund"],
                    cwd=frontend,
                    check=True,
                    timeout=600,
                )
            except subprocess.TimeoutExpired:
                stop_service("backend")
                raise SystemExit(
                    "前端依赖安装超时，请检查网络或 npm 镜像后重新执行 python dev.py start"
                )
        start_service(
            "frontend",
            [npm, "run", "dev"],
            frontend,
            environment_updates={
                "VITE_DEV_PORT": str(frontend_port),
                "VITE_BACKEND_PORT": str(backend_port),
            },
        )
        print(f"✓ 前端已启动（PID 文件: {PID_DIR / 'frontend.pid'}，端口: {frontend_port}）")
        if not wait_for_port(frontend_port):
            stop_service("frontend")
            raise SystemExit("前端启动失败，请查看 datas/logs/frontend.log")
if action == "status":
    print("=========================================")
    print("  服务状态")
    print("=========================================")
    for name in ("backend", "frontend"):
        state = "运行中" if process_alive(name) else "未运行"
        print(f"{name}: {state}")
    print("=========================================")
