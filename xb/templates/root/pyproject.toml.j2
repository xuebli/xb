[project]
name = "[[ package_name]]"
version = "1.0.0"
description = "[[ package_name_capitalized]] - UV + FastAPI + Vue3 + Electron Desktop App"
requires-python = ">=3.10"
dependencies = [
    "fastapi==0.136.0",
    "uvicorn==0.44.0",
    "loguru==0.7.3",
    "pyyaml==6.0.2",
]

[project.optional-dependencies]
dev = [
    "pyinstaller>=6.0",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["backend"]
