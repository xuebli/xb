#!/usr/bin/env python3
import os
import subprocess
import sys
from pathlib import Path

# Git 要求钩子文件位于仓库根目录下的 .git/hooks/pre-commit。
root = Path(subprocess.check_output(
    ["git", "rev-parse", "--show-toplevel"], text=True
).strip())
manager = root / "version/scripts/version_manager.py"
web = root / "version/scripts/web_version_manager.py"
gui = root / "version/scripts/gui_version_manager.py"
if not manager.exists():
    raise SystemExit(0)

changed = subprocess.check_output(
    ["git", "diff", "--cached", "--name-only"], text=True
).splitlines()
# 版本文件本身的更新不应再次触发版本检查。
excluded = ("version.json", "版本迭代日志.md", "package.json")
changed = [item for item in changed if not any(key in item for key in excluded)]
if not changed:
    raise SystemExit(0)

# 远程 IDE 和普通 SSH 都使用 Web 管理器。
# SSH_CONNECTION/SSH_CLIENT/SSH_TTY 由 sshd 注入，即使 ssh -X 没有成功建立 DISPLAY，
# 也不能误判成本地图形环境或直接跳过版本选择。
remote_ide = bool(os.getenv("VSCODE_IPC_HOOK_CLI")) or "server" in os.getenv("BROWSER", "")
remote_ssh = any(os.getenv(name) for name in ("SSH_CONNECTION", "SSH_CLIENT", "SSH_TTY"))

if remote_ide or remote_ssh:
    if not web.exists():
        print("版本管理器缺少 Web 脚本，已中止提交", file=sys.stderr)
        raise SystemExit(1)
    raise SystemExit(subprocess.run([sys.executable, str(web)]).returncode)

# 仅本地 X11/Windows 使用 Tk；SSH 场景已经在上面的 Web 分支处理。
if gui.exists() and (bool(os.getenv("DISPLAY")) or os.name == "nt"):
    arguments = [sys.executable, str(gui), "--check-changes"]
    raise SystemExit(subprocess.run(arguments).returncode)

# 纯终端提交保持兼容：没有可交互界面时跳过版本选择。
