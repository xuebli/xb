#!/usr/bin/env python3
import os
import shutil
import sys
from pathlib import Path

action = sys.argv[1] if len(sys.argv) > 1 else ""
# upgrade/abort 场景不能删除用户数据，必须直接退出。
if action in {"upgrade", "failed-upgrade", "abort-install", "abort-upgrade", "disappear"}:
    raise SystemExit(0)
if action not in {"remove", "purge"}:
    raise SystemExit(1)

# Debian 卸载前后清理 Electron/前端资源缓存，避免旧 assets 残留。
if os.name != "nt":
    # 清理安装目录中残留的前端静态资源缓存。
    shutil.rmtree(
        Path("/opt") / "[[ package_name_capitalized ]]" / "resources" / "frontend" / "assets",
        ignore_errors=True,
    )

homes = [Path.home()]
if action == "purge" and os.name != "nt":
    # purge 时遍历普通用户和 root，清理所有用户的应用数据。
    homes = [Path(entry.home_dir) for entry in __import__("pwd").getpwall()
             if entry.home_dir.startswith(("/home/", "/root"))]
for home in homes:
    paths = [home / ".config" / "[[ package_name]]",
             home / ".local" / "share" / "[[ package_name]]",
             home / ".config" / "[[ package_name]]-electron"]
    if action == "remove":
        paths = []
    for path in paths:
        shutil.rmtree(path, ignore_errors=True)
