const { app, BrowserWindow, Menu[% if enable_terminal %], ipcMain[% endif %] } = require('electron');
const { execFileSync, spawn } = require('child_process');
const fs = require('fs');
const path = require('path');
const os = require('os');
const yaml = require('js-yaml');

function userConfigRoot() {
    if (process.platform === 'win32') {
        return process.env.APPDATA || path.join(os.homedir(), 'AppData', 'Roaming');
    }
    if (process.platform === 'darwin') {
        return path.join(os.homedir(), 'Library', 'Application Support');
    }
    return path.join(os.homedir(), '.config');
}

const electronStateDir = path.join(userConfigRoot(), '[[ package_name]]-electron');
app.setPath('userData', electronStateDir);
app.setPath('sessionData', path.join(electronStateDir, 'Session'));

// 复刻 backend/managers/path_manager.py 的配置目录选择逻辑：
//   - 开发态(electron 跑源码)：<repo>/configs
//   - 项目目录跑打包二进制(<repo>/dist/server[.exe])：<repo>/configs
//   - 安装态：Linux ~/.config；Windows %APPDATA%；macOS Application Support
function resolveConfigDir() {
    const appName = '[[ package_name]]';
    if (!app.isPackaged) {
        return path.join(__dirname, '..', 'configs');
    }
    return path.join(userConfigRoot(), appName);
}

// 端口读取，与 path_manager.get_config_value 行为对齐：缺失/异常 fallback 默认值
function readPort(key, defaultPort) {
    try {
        const configPath = path.join(resolveConfigDir(), 'global_config.yaml');
        if (!fs.existsSync(configPath)) return defaultPort;
        const cfg = yaml.load(fs.readFileSync(configPath, 'utf-8')) || {};
        const val = cfg && cfg.ports && cfg.ports[key];
        const port = Number(val);
        return Number.isInteger(port) && port > 0 && port < 65536 ? port : defaultPort;
    } catch (e) {
        console.warn('[Ports] 读取 global_config.yaml 失败，回退默认端口:', e.message);
        return defaultPort;
    }
}

const BACKEND_PORT = readPort('backend', 8000);

let win;
let backend;
let backendPid;
let backendShutdownStarted = false;
let zoomFactor = 1;
[% if enable_terminal %]
let terminalFocused = false;
[% endif %]

function sleepSync(ms) {
    Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
}

function isProcessGroupRunning(pid) {
    try {
        process.kill(-pid, 0);
        return true;
    } catch (_) {
        return false;
    }
}

function shutdownBackendTree() {
    if (backendShutdownStarted) return;
    backendShutdownStarted = true;

    const pid = Number(backendPid || (backend && backend.pid));
    if (!Number.isInteger(pid) || pid <= 0) return;

    if (process.platform === 'win32') {
        try {
            // /T 递归结束 server.exe 拉起的所有业务子进程。
            // /F 保证 Electron 退出前命令已经完成，避免孤儿进程继续运行。
            execFileSync(
                'taskkill',
                ['/PID', String(pid), '/T', '/F'],
                { windowsHide: true, stdio: 'ignore' }
            );
        } catch (_) {
            // 进程可能已经自行退出。
        }
        return;
    }

    try {
        process.kill(-pid, 'SIGTERM');
    } catch (_) {
        return;
    }

    const deadline = Date.now() + 1500;
    while (Date.now() < deadline && isProcessGroupRunning(pid)) {
        sleepSync(50);
    }
    if (isProcessGroupRunning(pid)) {
        try {
            process.kill(-pid, 'SIGKILL');
        } catch (_) {
            // 进程组可能已在检查后退出。
        }
    }
}

[% if enable_terminal %]
ipcMain.on('terminal-focus', (_event, focused) => {
    terminalFocused = !!focused;
});
[% endif %]

function clampZoom(value) {
    return Math.min(3, Math.max(0.3, value));
}

function applyZoom(delta) {
    if (!win) return;
    zoomFactor = clampZoom(Number((zoomFactor + delta).toFixed(2)));
    win.webContents.setZoomFactor(zoomFactor);
}

function resetZoom() {
    if (!win) return;
    zoomFactor = 1;
    win.webContents.setZoomFactor(zoomFactor);
}

app.whenReady().then(() => {
    Menu.setApplicationMenu(null);

    const backendName = process.platform === 'win32' ? 'server.exe' : 'server';
    const backendPath = app.isPackaged
        ? path.join(process.resourcesPath, 'server-bin', backendName)
        : path.join(__dirname, '..', 'dist', backendName);

    if (!fs.existsSync(backendPath)) {
        const message = `后端程序不存在: ${backendPath}`;
        console.error(message);
        require('electron').dialog.showErrorBox('应用启动失败', message);
        app.quit();
        return;
    }

    backend = spawn(backendPath, [], {
        detached: process.platform !== 'win32',
        windowsHide: true,
        stdio: ['ignore', 'pipe', 'pipe']
    });
    backendPid = backend.pid;

    backend.on('error', (error) => {
        console.error('[Backend] 启动失败:', error);
        require('electron').dialog.showErrorBox(
            '应用启动失败',
            `无法启动后端程序:\n${backendPath}\n\n${error.message}`
        );
        app.quit();
    });

    backend.stdout.on('data', (data) => {
        const output = data.toString();
        console.log('[Backend]', output);

        if (output.includes('应用启动完成')) {
            win = new BrowserWindow({
                width: 1200,
                height: 800,
                webPreferences: {
                    preload: path.join(__dirname, 'preload.js')
                }
            });

            // 自定义常用桌面快捷键：隐藏菜单后，显式保留调试、全屏与缩放能力。
            win.webContents.on('before-input-event', (event, input) => {
                if (input.type !== 'keyDown' || !input.key) return;

                const key = input.key.toLowerCase();
                const ctrlOrCmd = input.control || input.meta;
                const isF12 = input.key === 'F12';
                const isCtrlShiftI = ctrlOrCmd && input.shift && key === 'i';
                const isF11 = input.key === 'F11';

                if (isF12 || isCtrlShiftI) {
                    win.webContents.toggleDevTools();
                    event.preventDefault();
                    return;
                }

                if (isF11) {
                    win.setFullScreen(!win.isFullScreen());
                    event.preventDefault();
                    return;
                }

[% if enable_terminal %]
                // 终端聚焦时把 Ctrl +/-/0 让给 xterm 调字号：整页 setZoomFactor 会缩放
                // canvas 导致字体发虚、鼠标选区错位，终端场景只应改 fontSize。
                // terminalFocused 由 preload 经 IPC 上报（见 preload.js）
                const isZoomKey = ctrlOrCmd
                    && (input.key === '+' || input.key === '=' || input.key === '-' || input.key === '0');
                if (isZoomKey && terminalFocused) {
                    return;
                }
[% endif %]

                if (ctrlOrCmd && (input.key === '+' || input.key === '=')) {
                    applyZoom(0.1);
                    event.preventDefault();
                    return;
                }

                if (ctrlOrCmd && input.key === '-') {
                    applyZoom(-0.1);
                    event.preventDefault();
                    return;
                }

                if (ctrlOrCmd && input.key === '0') {
                    resetZoom();
                    event.preventDefault();
                }
            });

            win.webContents.on('did-finish-load', () => {
                win.webContents.setZoomFactor(zoomFactor);
            });

            // Ctrl/Cmd + 鼠标滚轮触发 Chromium zoom-changed，这里接管缩放幅度。
            win.webContents.on('zoom-changed', (event, zoomDirection) => {
[% if enable_terminal %]
                if (terminalFocused) return;
[% endif %]
                event.preventDefault();
                applyZoom(zoomDirection === 'in' ? 0.1 : -0.1);
            });

            win.loadURL(`http://localhost:${BACKEND_PORT}`);
        }
    });

    backend.stderr.on('data', (data) => {
        console.error('[Backend]', data.toString());
    });
});

app.on('before-quit', shutdownBackendTree);
app.on('window-all-closed', () => {
    app.quit();
});
process.on('exit', shutdownBackendTree);
