const { contextBridge[% if enable_terminal %], ipcRenderer[% endif %] } = require('electron');

[% if enable_terminal %]
// 主进程的 before-input-event 是同步回调，无法异步查询渲染进程焦点，
// 因此由渲染进程在终端聚焦/失焦时主动上报，主进程只读缓存的布尔值
contextBridge.exposeInMainWorld('desktopBridge', {
    setTerminalFocused: (focused) => ipcRenderer.send('terminal-focus', !!focused),
});
[% else %]
contextBridge.exposeInMainWorld('desktopBridge', {});
[% endif %]
